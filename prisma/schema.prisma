// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

// A User is an authenticatable identity. It may or may not be linked to a
// Resident profile, and may hold EstateMember roles in one or more estates.
model User {
  id                String    @id @default(cuid())
  email             String?   @unique
  phone             String?   @unique
  passwordHash      String?
  name              String
  isPlatformAdmin   Boolean   @default(false)
  // Stamped on every successful password change (reset or authenticated
  // change) — the JWT session callback compares this against the token's
  // issued-at time to invalidate any session issued before the password
  // changed, since Credentials+JWT auth has no server-side session store
  // to revoke directly. See src/server/auth/config.ts.
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  memberships                EstateMember[]
  residentLinks              Resident[]
  auditLogs                  AuditLog[]           @relation("ActorUser")
  assignedMaintenanceTickets MaintenanceTicket[]  @relation("MaintenanceAssignee")
  assignedHousekeepingTasks  HousekeepingTask[]   @relation("HousekeepingAssignee")
  assignedDemoRequests       DemoRequest[]        @relation("DemoRequestAssignee")
  resolvedCommunityReports   CommunityReport[]    @relation("CommunityReportResolver")
  passwordResetTokens        PasswordResetToken[]

  propertyOwnerProfile       PropertyOwner?
  tenantProfile              Tenant?
  managedPropertyAssignments PropertyManager[]
  rentalApplicantProfile     RentalApplicant?
  shortletOperatorProfile    ShortletOperator?
  shortletGuestProfile       ShortletGuest?
}

// Only the SHA-256 hash of the raw token is ever stored — the raw,
// high-entropy token exists only in memory and in the emailed link, never
// at rest. Single-use (usedAt) and short-lived (expiresAt); a new request
// invalidates any previous unused token for the same user (see
// src/server/auth/passwordReset/service.ts).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Not tied to User — a request for an email that doesn't exist must still
// be counted, or the *absence* of throttling would itself reveal that an
// email is unregistered. Deliberately just enough to rate-limit; not a
// general-purpose security-event log (see AuditLog for that).
model PasswordResetRequestLog {
  id         String   @id @default(cuid())
  emailLower String
  ipHash     String?
  createdAt  DateTime @default(now())

  @@index([emailLower, createdAt])
  @@index([ipHash, createdAt])
}

// ---------------------------------------------------------------------------
// Platform & Plans
// ---------------------------------------------------------------------------

// Deliberately simple: no machine-enforced per-feature entitlement engine,
// since nothing in the app gates functionality by plan today except
// unitLimit (see createProperty in properties/service.ts). featureSummary
// is descriptive only. Pricing is per the spec's "finalize pricing later" —
// this just makes it configurable rather than hard-coded.
model Plan {
  id               String   @id @default(cuid())
  name             String
  monthlyPriceKobo Int
  annualPriceKobo  Int?
  unitLimit        Int? // null = unlimited
  featureSummary   String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  estates Estate[]
}

// ---------------------------------------------------------------------------
// Demo Requests
// ---------------------------------------------------------------------------

// A minimal atomic counter for reference numbers that aren't scoped to an
// estate (unlike EstateSequence, whose estateId FK is required) — same
// upsert-with-increment pattern, see src/server/modules/demoRequests/sequence.ts.
model PlatformSequence {
  key   String @id
  value Int    @default(0)
}

// A public-site "Request a Demo" submission. Deliberately not estate-scoped
// (the prospect doesn't have an estate yet) and not routed through the
// existing scoped()/Notification machinery, which assumes a tenant and a
// resident — see src/server/modules/demoRequests/. Multi-select fields use
// real Postgres enum arrays rather than Json, since these are fixed
// vocabularies the admin UI needs to filter/report on, not free-form data.
model DemoRequest {
  id              String @id @default(cuid())
  referenceNumber String @unique

  fullName               String
  email                  String
  phone                  String
  preferredContactMethod PreferredContactMethod?
  organizationName       String
  organizationType       OrganizationType

  country  String
  region   String?
  city     String
  timezone String?

  numberOfEstates        Int?
  // Nullable — the simplified form captures unitRange (a bucket) instead of
  // a raw count. Kept for older rows / anyone who still supplies an exact
  // number; the admin UI prefers unitRange's label when both are present.
  numberOfUnits          Int?
  unitRange              UnitRangeBucket?
  numberOfResidents      Int?
  shortletUnits          Int?
  // Only asked when interestedFeatures includes SHORTLET_MANAGEMENT.
  shortletBookingProcess String?
  shortletChallenge      String?

  currentManagementMethods ManagementMethod[]
  challenges               ChallengeArea[]
  // The simplified form's single "biggest operational challenge" question —
  // distinct from the (now-unused-in-the-UI, still-stored) multi-select
  // `challenges` above, which older rows may still have.
  primaryChallenge         ChallengeArea?
  interestedFeatures       FeatureInterest[]

  preferredDemoDate     DateTime?
  preferredDemoTime     String?
  alternateDemoDatetime String?
  // Admin-set once a demo is actually arranged — distinct from the
  // prospect's non-binding preference above (see spec: "Do not treat the
  // requested time as a confirmed appointment").
  scheduledDemoAt       DateTime?

  currentSoftware  String?
  primaryObjective String?
  comments         String?
  referralSource   String?
  consent          Boolean

  status           DemoRequestStatus @default(NEW)
  assignedToUserId String?
  // Admin-only working notes — never rendered on any prospect-facing page.
  internalNotes    String?
  // HMAC-SHA256 hash of the submitter's IP (see rateLimit.ts), used only to
  // rate-limit repeat submissions — never stores the raw IP.
  ipHash           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedTo User? @relation("DemoRequestAssignee", fields: [assignedToUserId], references: [id])

  @@index([status])
  @@index([ipHash, createdAt])
}

// ---------------------------------------------------------------------------
// Tenant root
// ---------------------------------------------------------------------------

model Estate {
  id                 String             @id @default(cuid())
  name               String
  slug               String             @unique
  logoUrl            String?
  address            String?
  city               String?
  state              String?
  postalCode         String?
  // Global-ready locale configuration. Nigeria remains the sensible
  // default for every existing and newly-created estate today (the only
  // market NidraQ actually operates in), but these are real per-estate
  // fields, not hardcoded assumptions — an estate admin can change them in
  // Settings, and every new organization is free to pick a different
  // country from creation. See src/lib/locale.ts for how these drive
  // currency/timezone formatting.
  country            String             @default("NG")
  currency           String             @default("NGN")
  timezone           String             @default("Africa/Lagos")
  locale             String             @default("en-NG")
  phoneCountryCode   String             @default("+234")
  contactEmail       String?
  contactPhone       String?
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  planId             String?
  trialEndsAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  plan                   Plan?                   @relation(fields: [planId], references: [id])
  members                EstateMember[]
  blocks                 Block[]
  streets                Street[]
  zones                  Zone[]
  properties             Property[]
  residents              Resident[]
  vehicles               Vehicle[]
  auditLogs              AuditLog[]
  charges                Charge[]
  invoices               Invoice[]
  payments               Payment[]
  receipts               Receipt[]
  sequences              EstateSequence[]
  visitorPasses          VisitorPass[]
  gateEntries            GateEntry[]
  vendors                Vendor[]
  maintenanceTickets     MaintenanceTicket[]
  maintenanceComments    MaintenanceComment[]
  utilityMeters          UtilityMeter[]
  meterReadings          MeterReading[]
  utilityBills           UtilityBill[]
  announcements          Announcement[]
  notifications          Notification[]
  communitySettings      CommunitySettings?
  classifiedCategories   ClassifiedCategory[]
  classifiedListings     ClassifiedListing[]
  classifiedImages       ClassifiedImage[]
  communityPosts         CommunityPost[]
  communityPostImages    CommunityPostImage[]
  communityComments      CommunityComment[]
  communityReactions     CommunityReaction[]
  communitySavedPosts    CommunitySavedPost[]
  communitySavedListings CommunitySavedListing[]
  communityEvents        CommunityEvent[]
  eventRsvps             EventRsvp[]
  communityReports       CommunityReport[]
  listingInquiries       ListingInquiry[]
  shortletSettings       ShortletSettings?
  shortletProperties     ShortletProperty[]
  shortletPropertyImages ShortletPropertyImage[]
  shortletUnits          ShortletUnit[]
  guests                 Guest[]
  reservations           Reservation[]
  availabilityBlocks     AvailabilityBlock[]
  housekeepingTasks      HousekeepingTask[]

  @@index([subscriptionStatus])
}

// Grants a User a Role within a specific Estate. A user can belong to
// multiple estates (e.g. a facility-management company staff member).
model EstateMember {
  id        String   @id @default(cuid())
  estateId  String
  userId    String
  role      Role
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([estateId, userId, role])
  @@index([estateId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Estate geography
// ---------------------------------------------------------------------------

model Block {
  id        String   @id @default(cuid())
  estateId  String
  name      String
  createdAt DateTime @default(now())

  estate     Estate     @relation(fields: [estateId], references: [id], onDelete: Cascade)
  properties Property[]

  @@index([estateId])
}

model Street {
  id        String   @id @default(cuid())
  estateId  String
  name      String
  createdAt DateTime @default(now())

  estate     Estate     @relation(fields: [estateId], references: [id], onDelete: Cascade)
  properties Property[]

  @@index([estateId])
}

model Zone {
  id        String   @id @default(cuid())
  estateId  String
  name      String
  createdAt DateTime @default(now())

  estate     Estate     @relation(fields: [estateId], references: [id], onDelete: Cascade)
  properties Property[]

  @@index([estateId])
}

// ---------------------------------------------------------------------------
// Properties & Units
// ---------------------------------------------------------------------------

// An addressable structure (a duplex, a block of flats, a standalone house).
model Property {
  id           String       @id @default(cuid())
  estateId     String
  blockId      String?
  streetId     String?
  zoneId       String?
  addressLabel String
  propertyType PropertyType
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  estate Estate  @relation(fields: [estateId], references: [id], onDelete: Cascade)
  block  Block?  @relation(fields: [blockId], references: [id])
  street Street? @relation(fields: [streetId], references: [id])
  zone   Zone?   @relation(fields: [zoneId], references: [id])
  units  Unit[]

  @@index([estateId])
}

// The billable / occupiable sub-entity. A standalone house still gets one
// implicit Unit so billing and occupancy always attach to a Unit.
model Unit {
  id              String          @id @default(cuid())
  propertyId      String
  estateId        String
  label           String
  occupancyStatus OccupancyStatus @default(VACANT)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  property      Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  occupancies   Occupancy[]
  invoices      Invoice[]
  utilityMeters UtilityMeter[]

  @@index([estateId])
  @@index([propertyId])
}

// ---------------------------------------------------------------------------
// Residents
// ---------------------------------------------------------------------------

// An estate-scoped profile. May or may not have a linked User (e.g. a
// household member with no login yet).
model Resident {
  id                             String                          @id @default(cuid())
  estateId                       String
  userId                         String?
  firstName                      String
  lastName                       String
  email                          String?
  phone                          String?
  emergencyContactName           String?
  emergencyContactPhone          String?
  // Set when an admin sends (or resends) a portal invite — userId being
  // set is what actually means "activated"; this is just for the admin
  // UI to distinguish "never invited" from "invited, not yet accepted."
  invitedAt                      DateTime?
  // Community preferences/moderation state — nullable, so an unset
  // preference falls back to the estate's CommunitySettings default.
  communityDisplayNamePreference CommunityDisplayNamePreference?
  communityGuidelinesAcceptedAt  DateTime?
  communitySuspendedAt           DateTime?
  communitySuspendedReason       String?
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt

  estate                 Estate                  @relation(fields: [estateId], references: [id], onDelete: Cascade)
  user                   User?                   @relation(fields: [userId], references: [id])
  occupancies            Occupancy[]
  vehicles               Vehicle[]
  invoices               Invoice[]
  visitorPasses          VisitorPass[]
  maintenanceTickets     MaintenanceTicket[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  communityPosts         CommunityPost[]
  communityComments      CommunityComment[]
  communityReactions     CommunityReaction[]
  communitySavedPosts    CommunitySavedPost[]
  classifiedListings     ClassifiedListing[]
  savedListings          CommunitySavedListing[]
  communityEvents        CommunityEvent[]
  eventRsvps             EventRsvp[]
  communityReports       CommunityReport[]
  listingInquiries       ListingInquiry[]
  inviteTokens           ResidentInviteToken[]

  @@index([estateId])
  @@index([userId])
}

// Mirrors PasswordResetToken's shape exactly (hash-only storage,
// single-use, short-lived) — this is "set your password and activate
// your portal account" rather than "reset an existing password," so it's
// keyed by residentId (who may not have a User yet) instead of userId.
model ResidentInviteToken {
  id         String    @id @default(cuid())
  residentId String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  resident Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([residentId])
}

// History of which Resident occupies which Unit, and in what capacity.
model Occupancy {
  id          String        @id @default(cuid())
  unitId      String
  residentId  String
  role        OccupancyRole
  moveInDate  DateTime
  moveOutDate DateTime?
  isCurrent   Boolean       @default(true)
  createdAt   DateTime      @default(now())

  unit     Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  resident Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([unitId])
  @@index([residentId])
}

model Vehicle {
  id          String   @id @default(cuid())
  estateId    String
  residentId  String
  plateNumber String
  make        String?
  model       String?
  color       String?
  createdAt   DateTime @default(now())

  estate   Estate   @relation(fields: [estateId], references: [id], onDelete: Cascade)
  resident Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([estateId])
  @@index([residentId])
}

// ---------------------------------------------------------------------------
// Billing & Payments
// ---------------------------------------------------------------------------

// Backs atomic, human-readable sequential numbers per estate (e.g.
// INV-000123). The upsert-with-increment in service code is safe under
// concurrent creation because Postgres serializes on this row's unique
// index lock within a transaction.
model EstateSequence {
  id       String @id @default(cuid())
  estateId String
  key      String
  value    Int    @default(0)

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)

  @@unique([estateId, key])
}

// A billing rule (e.g. "2026 Estate Service Charge") targeting some scope
// of the estate. Its effect is materialized immediately as Invoice rows at
// creation time — targetCriteria is kept only for display/audit, not
// re-resolved later, so changing estate structure afterward can't silently
// change who was billed.
model Charge {
  id             String           @id @default(cuid())
  estateId       String
  title          String
  description    String?
  chargeType     ChargeType
  amountKobo     Int
  dueDate        DateTime
  targetType     ChargeTargetType
  targetCriteria Json
  createdAt      DateTime         @default(now())

  estate   Estate    @relation(fields: [estateId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([estateId])
}

// One invoice = one charge (no multi-charge bundling) — matches how the
// product spec presents billing and avoids an abstraction this phase
// doesn't need. residentId is a snapshot of who was billed at generation
// time, not a live link to current occupancy.
model Invoice {
  id            String        @id @default(cuid())
  estateId      String
  chargeId      String
  unitId        String
  residentId    String?
  invoiceNumber String
  amountKobo    Int
  dueDate       DateTime
  status        InvoiceStatus @default(PENDING)
  createdAt     DateTime      @default(now())

  estate      Estate       @relation(fields: [estateId], references: [id], onDelete: Cascade)
  charge      Charge       @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  unit        Unit         @relation(fields: [unitId], references: [id])
  resident    Resident?    @relation(fields: [residentId], references: [id])
  payments    Payment[]
  utilityBill UtilityBill?

  @@unique([estateId, invoiceNumber])
  @@index([estateId])
  @@index([unitId])
  @@index([residentId])
}

model Payment {
  id                String        @id @default(cuid())
  estateId          String
  invoiceId         String
  amountKobo        Int
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  paystackReference String?       @unique
  note              String?
  recordedByUserId  String?
  approvedByUserId  String?
  approvedAt        DateTime?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())

  estate  Estate   @relation(fields: [estateId], references: [id], onDelete: Cascade)
  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  receipt Receipt?

  @@index([estateId])
  @@index([invoiceId])
}

model Receipt {
  id            String   @id @default(cuid())
  estateId      String
  paymentId     String   @unique
  receiptNumber String
  issuedAt      DateTime @default(now())

  estate  Estate  @relation(fields: [estateId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([estateId, receiptNumber])
  @@index([estateId])
}

// ---------------------------------------------------------------------------
// Visitors & Gate
// ---------------------------------------------------------------------------

// One invite = one visit occasion — carries the visitor's identity fields
// directly rather than a separate reusable Visitor profile, since nothing
// in this phase needs to reuse a visitor's details across visits.
model VisitorPass {
  id            String          @id @default(cuid())
  estateId      String
  residentId    String // host
  // Purely a labeling/filtering concern for the resident-facing UI — every
  // type shares the exact same underlying credential (PIN/QR/validity
  // window). Adding a genuinely different access type later doesn't
  // require a new model, just a new enum value.
  passType      VisitorPassType @default(VISITOR)
  visitorName   String
  visitorPhone  String?
  vehicleNumber String?
  note          String?
  startTime     DateTime
  expiresAt     DateTime
  // 6 digits, time-scoped uniqueness only (see createVisitorPass) — not a
  // DB unique constraint, since permanently reserving PINs would
  // eventually exhaust the 1,000,000-combination space.
  pin           String
  isRevoked     Boolean         @default(false)
  cancelledAt   DateTime?
  createdAt     DateTime        @default(now())

  estate      Estate      @relation(fields: [estateId], references: [id], onDelete: Cascade)
  resident    Resident    @relation(fields: [residentId], references: [id], onDelete: Cascade)
  gateEntries GateEntry[]

  @@index([estateId])
  @@index([residentId])
}

// A single pass-through-the-gate event. Separate from VisitorPass so one
// pass can be used for multiple entries/exits within its validity window,
// and so "visitors currently checked in" is a direct query
// (checkOutAt IS NULL) rather than derived state on the pass itself.
model GateEntry {
  id             String    @id @default(cuid())
  estateId       String
  passId         String
  gate           String // free text, e.g. "Gate 1" — no Gate model for MVP
  securityUserId String
  checkInAt      DateTime  @default(now())
  checkOutAt     DateTime?
  wasOverride    Boolean   @default(false)
  overrideReason String?

  estate Estate      @relation(fields: [estateId], references: [id], onDelete: Cascade)
  pass   VisitorPass @relation(fields: [passId], references: [id], onDelete: Cascade)

  @@index([estateId])
  @@index([passId])
}

// ---------------------------------------------------------------------------
// Maintenance & Vendors
// ---------------------------------------------------------------------------

// A directory entry a FACILITY_MANAGER can attach to a ticket for
// record-keeping — not a login. A vendor's own staff who need to see
// their assigned tickets are separate Users with Role.VENDOR, linked via
// MaintenanceTicket.assignedToUserId, not via this model.
// Vendor is a first-class NidraQ entity, not information duplicated across
// maintenance requests — see src/server/modules/vendors/. Still a
// directory-only record (no login), same as before; isApproved/contract
// dates/notes are the lightweight expansion requested, deliberately not a
// full procurement/invoicing subsystem.
model Vendor {
  id                String               @id @default(cuid())
  estateId          String
  name              String
  contactName       String?
  phone             String?
  email             String?
  category          MaintenanceCategory?
  isApproved        Boolean              @default(true)
  contractStartDate DateTime?
  contractEndDate   DateTime?
  notes             String?
  createdAt         DateTime             @default(now())

  estate  Estate              @relation(fields: [estateId], references: [id], onDelete: Cascade)
  tickets MaintenanceTicket[]

  @@index([estateId])
}

model MaintenanceTicket {
  id               String              @id @default(cuid())
  estateId         String
  ticketNumber     String
  // Nullable so the same engine can carry an NidraQ Shortlet ticket
  // (shortletUnitId set, no resident) alongside a residential one
  // (residentId set, no shortlet unit) — exactly one is ever set. Every
  // resident-facing code path still always supplies residentId and never
  // touches shortletUnitId, so existing behavior is unchanged.
  residentId       String? // reporter (residential)
  shortletUnitId   String? // NidraQ Shortlet unit (shortlet)
  category         MaintenanceCategory
  description      String
  location         String?
  priority         MaintenancePriority
  status           MaintenanceStatus   @default(REPORTED)
  assignedToUserId String? // internal staff or a VENDOR-role user who can log in
  vendorId         String? // directory-only record, for record-keeping

  residentSatisfied Boolean?
  residentRating    Int?
  residentFeedback  String?

  assignedAt DateTime?
  resolvedAt DateTime?
  closedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  estate         Estate               @relation(fields: [estateId], references: [id], onDelete: Cascade)
  resident       Resident?            @relation(fields: [residentId], references: [id], onDelete: Cascade)
  shortletUnit   ShortletUnit?        @relation(fields: [shortletUnitId], references: [id], onDelete: Cascade)
  vendor         Vendor?              @relation(fields: [vendorId], references: [id])
  assignedToUser User?                @relation("MaintenanceAssignee", fields: [assignedToUserId], references: [id])
  comments       MaintenanceComment[]

  @@unique([estateId, ticketNumber])
  @@index([estateId])
  @@index([residentId])
  @@index([shortletUnitId])
  @@index([assignedToUserId])
}

// Doubles as the resident-visible progress log: a plain note, or a note
// alongside a status transition (newStatus set) — no separate free-form
// discussion feature, since the workflow's status history already is the
// "progress" the spec asks for.
model MaintenanceComment {
  id           String             @id @default(cuid())
  estateId     String
  ticketId     String
  authorUserId String
  body         String
  newStatus    MaintenanceStatus?
  createdAt    DateTime           @default(now())

  estate Estate            @relation(fields: [estateId], references: [id], onDelete: Cascade)
  ticket MaintenanceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([estateId])
  @@index([ticketId])
}

// ---------------------------------------------------------------------------
// Utilities (manual meter billing)
// ---------------------------------------------------------------------------

// Manual-entry only — the schema doesn't assume anything about how a
// reading arrives, so a future automated/smart-meter feed is additive (a
// new reading-creation path), not a rewrite.
model UtilityMeter {
  id          String     @id @default(cuid())
  estateId    String
  unitId      String
  utilityType ChargeType // constrained to ELECTRICITY | WATER in the zod schema
  meterNumber String
  rateKobo    Int // price per consumption unit
  createdAt   DateTime   @default(now())

  estate   Estate         @relation(fields: [estateId], references: [id], onDelete: Cascade)
  unit     Unit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  readings MeterReading[]

  @@index([estateId])
  @@index([unitId])
}

// previousReading auto-copies from this meter's last reading rather than
// being typed in each time — immutable history, no re-entry risk. Null
// only for a meter's very first reading, which just establishes a
// baseline (no bill is generated until a second reading exists).
model MeterReading {
  id               String   @id @default(cuid())
  estateId         String
  meterId          String
  previousReading  Int?
  currentReading   Int
  readingDate      DateTime
  recordedByUserId String
  createdAt        DateTime @default(now())

  estate Estate       @relation(fields: [estateId], references: [id], onDelete: Cascade)
  meter  UtilityMeter @relation(fields: [meterId], references: [id], onDelete: Cascade)
  bill   UtilityBill?

  @@index([estateId])
  @@index([meterId])
}

// Ties a reading to the Invoice it generated. The bill IS an Invoice
// (reusing Paystack/manual payment/receipts/finance-dashboard rather than
// a parallel payment path) — this row just keeps the utility-specific
// consumption/rate detail alongside that Invoice.
model UtilityBill {
  id             String   @id @default(cuid())
  estateId       String
  meterReadingId String   @unique
  invoiceId      String   @unique
  consumption    Int
  rateKobo       Int
  amountKobo     Int
  createdAt      DateTime @default(now())

  estate       Estate       @relation(fields: [estateId], references: [id], onDelete: Cascade)
  meterReading MeterReading @relation(fields: [meterReadingId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([estateId])
}

// ---------------------------------------------------------------------------
// Announcements & Notifications
// ---------------------------------------------------------------------------

// Its effect is materialized immediately as Notification rows at creation
// time, same as Charge/Invoice generation — targetCriteria is kept only
// for display/audit, not re-resolved later.
model Announcement {
  id             String                 @id @default(cuid())
  estateId       String
  authorUserId   String
  title          String
  body           String
  category       AnnouncementCategory
  targetType     AnnouncementTargetType
  targetCriteria Json
  createdAt      DateTime               @default(now())

  estate        Estate         @relation(fields: [estateId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([estateId])
}

// The shared notification event system — announcementId is nullable so a
// future event (payment confirmed, visitor checked in) can use the same
// table/dispatcher without a schema change; this isn't an
// announcements-only inbox.
model Notification {
  id                String                  @id @default(cuid())
  estateId          String
  residentId        String
  announcementId    String?
  // What triggered this notification (e.g. "bill.created",
  // "payment.confirmed", "maintenance.status_changed") — lets a future
  // provider pick the right message template and lets notification
  // history be filtered/reported on by event, not just free-text title.
  eventType         String?
  title             String
  body              String
  channel           NotificationChannelType @default(IN_APP)
  status            NotificationStatus      @default(PENDING)
  // Delivery-provider tracking — unused while only InAppChannel is enabled,
  // populated once a real EMAIL/WHATSAPP/SMS provider is wired in.
  provider          String?
  externalMessageId String?
  failureReason     String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  createdAt         DateTime                @default(now())

  estate       Estate        @relation(fields: [estateId], references: [id], onDelete: Cascade)
  resident     Resident      @relation(fields: [residentId], references: [id], onDelete: Cascade)
  announcement Announcement? @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([estateId])
  @@index([residentId])
  @@index([announcementId])
}

// One row per Resident. Consent is tracked explicitly and separately from
// the "do we have a phone number" question — having a number is never
// treated as permission to message it. Transactional notifications (bills,
// payment confirmations, maintenance updates) are considered a normal part
// of operating the account and aren't gated by marketingOptIn; only
// non-essential/marketing-style messages should ever check that flag.
model NotificationPreference {
  id                    String    @id @default(cuid())
  residentId            String    @unique
  emailOptIn            Boolean   @default(true)
  whatsappOptIn         Boolean   @default(false)
  whatsappNumber        String?
  whatsappCountryCode   String?
  whatsappConsentAt     DateTime?
  whatsappConsentSource String?
  whatsappOptOutAt      DateTime?
  marketingOptIn        Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  resident Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Community (Feed, Classifieds, Events, Moderation)
// ---------------------------------------------------------------------------

// One row per estate. Deliberately created lazily (see
// src/server/modules/community/settings.ts) rather than at Estate creation
// time, same as how ClassifiedCategory rows are seeded on first access.
model CommunitySettings {
  id                           String                         @id @default(cuid())
  estateId                     String                         @unique
  communityEnabled             Boolean                        @default(true)
  classifiedsEnabled           Boolean                        @default(true)
  listingsRequireApproval      Boolean                        @default(false)
  guidelinesText               String?
  defaultDisplayNamePreference CommunityDisplayNamePreference @default(FIRST_NAME_LAST_INITIAL)
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)
}

// Per-estate, not a global enum, so an admin can enable/disable which
// categories their estate uses (spec: "configure available categories per
// estate") — seeded from a fixed default list on first access, not
// arbitrary free-text categories, to keep Classifieds search/filter
// meaningful.
model ClassifiedCategory {
  id        String   @id @default(cuid())
  estateId  String
  key       String
  label     String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  estate   Estate              @relation(fields: [estateId], references: [id], onDelete: Cascade)
  listings ClassifiedListing[]

  @@unique([estateId, key])
  @@index([estateId])
}

// The shortlet-specific fields below are nullable and only populated when
// categoryId points at the Shortlets category — deliberately not a
// separate booking model (see spec: "do not build a full Airbnb-style
// marketplace"), just a few extra optional columns on the same listing.
model ClassifiedListing {
  id               String                  @id @default(cuid())
  estateId         String
  sellerResidentId String
  categoryId       String
  title            String
  description      String
  priceKobo        Int?
  currency         String                  @default("NGN")
  negotiable       Boolean                 @default(false)
  condition        ClassifiedCondition?
  // Optional, deliberately coarse (e.g. "Near Block C") — never the
  // resident's exact unit number, which stays server-side only (see
  // getDisplayIdentity() — public listing/post views never expose it).
  locationNote     String?
  contactMethods   ListingContactMethod[]
  whatsappNumber   String?
  phoneNumber      String?
  status           ClassifiedListingStatus @default(ACTIVE)
  moderationStatus CommunityVisibility     @default(VISIBLE)
  expiresAt        DateTime?
  // Null while pending when CommunitySettings.listingsRequireApproval is
  // on; set the moment it's created otherwise.
  approvedAt       DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  nightlyRateKobo Int?
  bedrooms        Int?
  maxGuests       Int?
  amenities       String[]
  availableFrom   DateTime?
  availableTo     DateTime?

  estate    Estate                  @relation(fields: [estateId], references: [id], onDelete: Cascade)
  seller    Resident                @relation(fields: [sellerResidentId], references: [id], onDelete: Cascade)
  category  ClassifiedCategory      @relation(fields: [categoryId], references: [id])
  images    ClassifiedImage[]
  savedBy   CommunitySavedListing[]
  inquiries ListingInquiry[]

  @@index([estateId, status])
  @@index([categoryId])
}

model ClassifiedImage {
  id        String   @id @default(cuid())
  estateId  String
  listingId String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  estate  Estate            @relation(fields: [estateId], references: [id], onDelete: Cascade)
  listing ClassifiedListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model CommunitySavedListing {
  id         String   @id @default(cuid())
  estateId   String
  residentId String
  listingId  String
  createdAt  DateTime @default(now())

  estate   Estate            @relation(fields: [estateId], references: [id], onDelete: Cascade)
  resident Resident          @relation(fields: [residentId], references: [id], onDelete: Cascade)
  listing  ClassifiedListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([residentId, listingId])
  @@index([estateId])
}

// A one-shot message to a seller, delivered as a row the seller reads on
// their own listing — the MVP's "in-app contact option", deliberately not
// a threaded conversation (see spec §12: reuse existing infra, don't build
// a separate messaging system; NidraQ has none today).
model ListingInquiry {
  id              String   @id @default(cuid())
  estateId        String
  listingId       String
  buyerResidentId String
  message         String
  createdAt       DateTime @default(now())

  estate  Estate            @relation(fields: [estateId], references: [id], onDelete: Cascade)
  listing ClassifiedListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer   Resident          @relation(fields: [buyerResidentId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

// Lost & Found is a postType, not a separate system (spec §14: "should
// also appear within Community Classifieds/Feed") — lostFoundKind/
// lostFoundResolvedAt are only populated when postType = LOST_FOUND.
// Official estate posts are NOT rows here — the Feed reads Announcement
// directly and interleaves it at query time (see
// src/server/modules/community/posts.ts) to avoid duplicating that data.
model CommunityPost {
  id                  String              @id @default(cuid())
  estateId            String
  authorResidentId    String
  postType            CommunityPostType   @default(TEXT)
  body                String
  lostFoundKind       LostFoundKind?
  lostFoundResolvedAt DateTime?
  moderationStatus    CommunityVisibility @default(VISIBLE)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  estate    Estate               @relation(fields: [estateId], references: [id], onDelete: Cascade)
  author    Resident             @relation(fields: [authorResidentId], references: [id], onDelete: Cascade)
  images    CommunityPostImage[]
  comments  CommunityComment[]
  reactions CommunityReaction[]
  savedBy   CommunitySavedPost[]

  @@index([estateId, createdAt])
}

model CommunityPostImage {
  id        String   @id @default(cuid())
  estateId  String
  postId    String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  estate Estate        @relation(fields: [estateId], references: [id], onDelete: Cascade)
  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

// parentCommentId supports one level of "Reply" (spec §6) — not a full
// arbitrarily-nested thread.
model CommunityComment {
  id               String              @id @default(cuid())
  estateId         String
  postId           String
  authorResidentId String
  parentCommentId  String?
  body             String
  moderationStatus CommunityVisibility @default(VISIBLE)
  createdAt        DateTime            @default(now())

  estate    Estate              @relation(fields: [estateId], references: [id], onDelete: Cascade)
  post      CommunityPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    Resident            @relation(fields: [authorResidentId], references: [id], onDelete: Cascade)
  parent    CommunityComment?   @relation("CommentReplies", fields: [parentCommentId], references: [id])
  replies   CommunityComment[]  @relation("CommentReplies")
  reactions CommunityReaction[]

  @@index([postId])
}

// Single LIKE type for now (spec: "keep reactions simple initially") —
// exactly one of postId/commentId is set. Postgres treats each NULL as
// distinct in a unique index, so the two partial-key uniques below don't
// conflict with each other.
model CommunityReaction {
  id         String   @id @default(cuid())
  estateId   String
  residentId String
  postId     String?
  commentId  String?
  createdAt  DateTime @default(now())

  estate   Estate            @relation(fields: [estateId], references: [id], onDelete: Cascade)
  resident Resident          @relation(fields: [residentId], references: [id], onDelete: Cascade)
  post     CommunityPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment  CommunityComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([residentId, postId])
  @@unique([residentId, commentId])
  @@index([estateId])
}

model CommunitySavedPost {
  id         String   @id @default(cuid())
  estateId   String
  residentId String
  postId     String
  createdAt  DateTime @default(now())

  estate   Estate        @relation(fields: [estateId], references: [id], onDelete: Cascade)
  resident Resident      @relation(fields: [residentId], references: [id], onDelete: Cascade)
  post     CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([residentId, postId])
  @@index([estateId])
}

model CommunityEvent {
  id                  String              @id @default(cuid())
  estateId            String
  organizerResidentId String?
  title               String
  description         String?
  eventDate           DateTime
  eventTime           String?
  location            String?
  moderationStatus    CommunityVisibility @default(VISIBLE)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  estate    Estate      @relation(fields: [estateId], references: [id], onDelete: Cascade)
  organizer Resident?   @relation(fields: [organizerResidentId], references: [id])
  rsvps     EventRsvp[]

  @@index([estateId, eventDate])
}

model EventRsvp {
  id         String          @id @default(cuid())
  estateId   String
  eventId    String
  residentId String
  status     EventRsvpStatus
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  estate   Estate         @relation(fields: [estateId], references: [id], onDelete: Cascade)
  event    CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  resident Resident       @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@unique([eventId, residentId])
  @@index([estateId])
}

// A resident filing a report — user-generated content, distinct from the
// moderation *action* taken on it (which reuses the existing AuditLog,
// see recordAudit() in src/server/modules/community/moderation.ts).
model CommunityReport {
  id                 String                    @id @default(cuid())
  estateId           String
  reporterResidentId String
  targetType         CommunityReportTargetType
  targetId           String
  reason             CommunityReportReason
  details            String?
  status             CommunityReportStatus     @default(OPEN)
  createdAt          DateTime                  @default(now())
  resolvedAt         DateTime?
  resolvedByUserId   String?

  estate     Estate   @relation(fields: [estateId], references: [id], onDelete: Cascade)
  reporter   Resident @relation(fields: [reporterResidentId], references: [id], onDelete: Cascade)
  resolvedBy User?    @relation("CommunityReportResolver", fields: [resolvedByUserId], references: [id])

  @@index([estateId, status])
}

// ---------------------------------------------------------------------------
// NidraQ Shortlet — a separate operations module for shortlet/serviced-
// apartment operators, deliberately kept apart from the residential
// Community/Classifieds experience above. Reuses Estate/EstateMember/RBAC/
// scoped()/AuditLog/S3 rather than a parallel tenant concept — an operator
// estate simply never populates the residential geography/resident tables.
// ---------------------------------------------------------------------------

// One row per estate, created lazily on first platform-admin toggle (same
// pattern as CommunitySettings) — enabling Shortlet is a platform-admin
// controlled subscription entitlement, not an estate-admin self-serve
// toggle like Community.
model ShortletSettings {
  id              String   @id @default(cuid())
  estateId        String   @unique
  enabled         Boolean  @default(false)
  defaultCurrency String   @default("NGN")
  defaultTimezone String   @default("Africa/Lagos")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)
}

model ShortletProperty {
  id                   String                 @id @default(cuid())
  estateId             String
  name                 String
  propertyType         ShortletPropertyType
  address              String
  country              String
  city                 String
  // Nullable overrides of ShortletSettings.defaultCurrency/defaultTimezone
  // — a property manager's portfolio can span multiple markets (a Lagos
  // property and a future Accra or Nairobi property), so each property may
  // opt out of the estate-wide default rather than being forced onto it.
  // Null means "use the estate default."
  currency             String?
  timezone             String?
  bedrooms             Int
  bathrooms            Int
  maxGuests            Int
  amenities            String[]
  description          String?
  houseRules           String?
  checkInTime          String // e.g. "15:00" — interpreted in ShortletSettings.defaultTimezone
  checkOutTime         String
  baseNightlyRateMinor Int
  cleaningFeeMinor     Int                    @default(0)
  securityDepositMinor Int                    @default(0)
  minStayNights        Int                    @default(1)
  maxStayNights        Int?
  status               ShortletPropertyStatus @default(ACTIVE)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  estate Estate                  @relation(fields: [estateId], references: [id], onDelete: Cascade)
  units  ShortletUnit[]
  images ShortletPropertyImage[]

  @@index([estateId, status])
}

model ShortletPropertyImage {
  id         String   @id @default(cuid())
  estateId   String
  propertyId String
  url        String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  estate   Estate           @relation(fields: [estateId], references: [id], onDelete: Cascade)
  property ShortletProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

// The actual bookable entity — mirrors the Property -> Unit split in the
// residential schema exactly, so a single-unit property still gets one
// auto-created unit and Reservations always reference a unit, never a
// property directly (supports "multiple units within one building").
model ShortletUnit {
  id         String                 @id @default(cuid())
  estateId   String
  propertyId String
  unitLabel  String
  status     ShortletPropertyStatus @default(ACTIVE)
  createdAt  DateTime               @default(now())

  estate             Estate              @relation(fields: [estateId], references: [id], onDelete: Cascade)
  property           ShortletProperty    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservations       Reservation[]
  availabilityBlocks AvailabilityBlock[]
  maintenanceTickets MaintenanceTicket[]
  housekeepingTasks  HousekeepingTask[]

  @@index([estateId])
  @@index([propertyId])
}

// Deliberately separate from Resident — a shortlet guest is not an estate
// resident. "Previous stays" is derived from the Reservation relation, not
// a stored field.
model Guest {
  id                    String   @id @default(cuid())
  estateId              String
  fullName              String
  phone                 String
  email                 String?
  country               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  vehicleDetails        String?
  idType                String?
  idNumber              String?
  notes                 String?
  preferences           String?
  createdAt             DateTime @default(now())

  estate       Estate        @relation(fields: [estateId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@index([estateId])
}

// Amounts are plain fields this phase (no Payment integration yet — see
// Phase 2 of the Shortlet build). outstandingAmountMinor is intentionally
// not stored: it's always totalAmountMinor - amountPaidMinor, computed by
// callers, same "recompute rather than trust a stale field" instinct as
// Invoice.status elsewhere in this schema.
model Reservation {
  id                    String                @id @default(cuid())
  estateId              String
  reservationNumber     String
  unitId                String
  guestId               String
  checkInDate           DateTime
  checkOutDate          DateTime
  numberOfGuests        Int
  nightlyRateMinor      Int
  nights                Int
  taxesMinor            Int                   @default(0)
  cleaningFeeMinor      Int                   @default(0)
  securityDepositMinor  Int                   @default(0)
  discountMinor         Int                   @default(0)
  additionalFeesMinor   Int                   @default(0)
  totalAmountMinor      Int
  amountPaidMinor       Int                   @default(0)
  bookingSource         ShortletBookingSource
  status                ReservationStatus     @default(PENDING)
  notes                 String?
  createdByUserId       String?
  // Future channel-manager integration readiness (spec: "ensure
  // reservations can contain booking source, external reservation ID,
  // external channel, synchronization status") — no integration or sync
  // logic exists yet, these are just cheap, additive columns so a future
  // integration doesn't need another migration.
  externalReservationId String?
  externalChannel       String?
  syncStatus            String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  estate Estate       @relation(fields: [estateId], references: [id], onDelete: Cascade)
  unit   ShortletUnit @relation(fields: [unitId], references: [id])
  guest  Guest        @relation(fields: [guestId], references: [id])

  @@unique([estateId, reservationNumber])
  @@index([estateId, status])
  @@index([unitId, checkInDate, checkOutDate])
}

// A cleaning task for a Shortlet unit. "Cleaning required" for dashboard/
// calendar purposes is derived (does this unit have an open task?), not a
// stored status on ShortletUnit — avoids two sources of truth needing to
// stay in sync. Auto-created (status PENDING) when a Reservation transitions
// to CHECKED_OUT — see updateReservationStatus in
// src/server/modules/shortlet/reservations.ts.
model HousekeepingTask {
  id               String               @id @default(cuid())
  estateId         String
  unitId           String
  status           HousekeepingStatus   @default(PENDING)
  assignedToUserId String?
  dueAt            DateTime?
  priority         MaintenancePriority?
  notes            String?
  completedAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  estate         Estate       @relation(fields: [estateId], references: [id], onDelete: Cascade)
  unit           ShortletUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  assignedToUser User?        @relation("HousekeepingAssignee", fields: [assignedToUserId], references: [id])

  @@index([estateId, status])
  @@index([unitId])
}

// Owner-blocked / manually-unavailable date ranges, feeding the calendar's
// non-reservation states. Maintenance-driven blocking arrives in Phase 3
// once the maintenance-integration models exist — "OTHER" covers the gap
// until then.
model AvailabilityBlock {
  id              String                  @id @default(cuid())
  estateId        String
  unitId          String
  startDate       DateTime
  endDate         DateTime
  reason          AvailabilityBlockReason
  notes           String?
  createdByUserId String?
  createdAt       DateTime                @default(now())

  estate Estate       @relation(fields: [estateId], references: [id], onDelete: Cascade)
  unit   ShortletUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId, startDate, endDate])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(cuid())
  estateId    String? // null for platform-level actions
  actorUserId String?
  action      String // e.g. "property.created", "invoice.amount_changed"
  entityType  String
  entityId    String
  beforeJson  Json?
  afterJson   Json?
  createdAt   DateTime @default(now())

  estate Estate? @relation(fields: [estateId], references: [id])
  actor  User?   @relation("ActorUser", fields: [actorUserId], references: [id])

  @@index([estateId])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Tenant Management — a separate NidraQ product line, not an extension of
// Estate Management. A landlord/property/tenant/lease relationship is a
// different business concept from an estate/resident relationship, even
// though the same person can be both (e.g. a landlord who also lives in a
// NidraQ-managed estate). Deliberately NOT estate-scoped and NOT routed
// through scoped()/EstateMember/the Role enum used there — those model
// "who has what permission inside one Estate," which doesn't apply here.
// Authorization instead follows direct ownership: a User "is a landlord"
// because a PropertyOwner row references them, "is a tenant" because a
// Tenant row references them, and "is a property manager" because a
// PropertyManager assignment references them — exactly like how
// getResidentByUserId already establishes "is a resident" for Estate
// Management, not a separately-granted role flag. This lets one User hold
// every role at once with zero duplicate accounts.
//
// Money is stored in minor units (kobo-equivalent), matching every other
// monetary field in this schema. Reuses PlatformSequence (see
// src/server/modules/demoRequests/sequence.ts) for lease codes, rent
// receipt numbers and maintenance request codes — no new sequence
// mechanism. Reuses recordAudit() (estateId: null, same as DemoRequest and
// password-reset events) for sensitive lease/payment/document changes.
// Reuses the existing S3 presigned-upload helper (src/server/modules/
// storage/s3.ts) for inspection/maintenance photos — optional, same
// graceful degradation as Community photos.
// ---------------------------------------------------------------------------

enum RentalPropertyType {
  APARTMENT_BUILDING
  DUPLEX
  DETACHED_HOUSE
  TERRACE
  FLAT
  COMMERCIAL
  MIXED_USE
  OTHER
}

enum RentalUnitStatus {
  VACANT
  OCCUPIED
  RESERVED
  MAINTENANCE
  UNAVAILABLE
}

// Nigerian rent is very often annual, sometimes quarterly/semi-annual —
// never assume monthly. ANNUAL is the default for new units.
enum RentFrequency {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
  // No fixed step — the billing engine bills the whole lease term as one
  // obligation rather than guessing a period length. A true irregular
  // schedule (e.g. specific one-off dates) would need its own input UI;
  // out of scope for this phase.
  CUSTOM
}

enum TenantStatus {
  APPLICANT
  APPROVED
  ACTIVE
  NOTICE_GIVEN
  FORMER
}

enum LeaseStatus {
  DRAFT
  PENDING_SIGNATURE
  ACTIVE
  EXPIRING
  RENEWAL_PENDING
  EXPIRED
  TERMINATED
}

enum RentObligationStatus {
  UPCOMING
  DUE
  PARTIALLY_PAID
  PAID
  OVERDUE
  WAIVED
  CANCELLED
}

enum RentPaymentMethod {
  BANK_TRANSFER
  CARD
  CASH
  POS
  ONLINE_PAYMENT
  CHEQUE
  OTHER
}

// COMPLETED payments are the only ones that count as money received.
// PENDING exists only for an online payment between "checkout started" and
// "webhook confirmed" — it must never move an obligation's amountPaidMinor.
// REVERSED payments keep their row (never deleted) with reversal metadata;
// see reversePayment() in payments.ts for why deletion is never an option
// for financial records.
enum RentPaymentStatus {
  PENDING
  COMPLETED
  FAILED
  ABANDONED
  REVERSED
}

// Non-rent items billed to a tenant. Deliberately separate from
// RentObligation (which stays rent-only, since it drives lease/occupancy
// logic) — a TenantCharge is a simpler, standalone billable line item that
// a Payment can also allocate against via PaymentAllocation. Prefixed
// Rental*/TenantCharge to avoid colliding with the existing Estate
// Management Charge/ChargeType (service-charge billing), same convention
// as RentalMaintenanceCategory vs MaintenanceCategory.
enum RentalChargeType {
  SERVICE_CHARGE
  SECURITY_DEPOSIT
  UTILITY
  MAINTENANCE
  LATE_FEE
  OTHER
}

enum RentalChargeStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  WAIVED
  CANCELLED
}

enum ManagementFeeType {
  PERCENTAGE
  FIXED_MONTHLY
  FIXED_ANNUAL
  CUSTOM
}

enum LandlordSettlementStatus {
  PENDING
  APPROVED
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

// Which side of the due date a reminder offset counts from — paired with
// an arbitrary `offsetDays` (not a fixed enum of milestones) so a
// landlord's custom day counts work the same way the presets do. See
// RentReminderSetting/RentReminderLog.
enum ReminderDirection {
  BEFORE_DUE
  AFTER_DUE
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
}

// Prefixed Rental* to avoid colliding with the existing estate-maintenance
// MaintenanceCategory/MaintenancePriority/MaintenanceStatus enums, which
// describe a different workflow (resident-reported estate tickets).
enum RentalMaintenanceCategory {
  PLUMBING
  ELECTRICAL
  AIR_CONDITIONING
  APPLIANCE
  STRUCTURAL
  SECURITY
  WATER
  GENERATOR_POWER
  CLEANING
  OTHER
}

enum RentalMaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RentalMaintenanceStatus {
  SUBMITTED
  ACKNOWLEDGED
  ASSIGNED
  IN_PROGRESS
  WAITING
  COMPLETED
  CLOSED
}

enum PropertyInspectionType {
  MOVE_IN
  ROUTINE
  MOVE_OUT
  MAINTENANCE
  OWNER_REQUESTED
}

enum MoveInStage {
  STARTED
  LEASE_SIGNED
  DEPOSIT_RECORDED
  RENT_RECORDED
  INSPECTION_DONE
  KEYS_ISSUED
  COMPLETED
}

enum MoveOutStage {
  NOTICE_RECEIVED
  DATE_CONFIRMED
  FINAL_REVIEW
  INSPECTION_DONE
  DEPOSIT_RECONCILED
  KEYS_RETURNED
  COMPLETED
}

// The landlord/property-owner — may or may not have a NidraQ login
// (userId is nullable so a manager can create an owner record before the
// owner ever signs up, e.g. for a diaspora landlord who'll log in later).
model PropertyOwner {
  id                           String    @id @default(cuid())
  userId                       String?   @unique
  name                         String
  email                        String?
  phone                        String?
  whatsapp                     String?
  countryOfResidence           String?
  preferredTimezone            String?
  preferredCurrency            String    @default("NGN")
  preferredCommunicationMethod String?
  notes                        String?
  // Payout/bank details are sensitive — deliberately plain nullable fields
  // (no separate "vault" table for this phase) but every read/write path
  // must go through getPayoutDetails()/updatePayoutDetails() in
  // property.ts, which restrict access to the owner themselves or a
  // platform admin and audit every change. Never included in the general
  // PropertyOwner queries used by listAccessibleProperties/searchLandlords.
  payoutBankName               String?
  payoutAccountNumber          String?
  payoutAccountName            String?
  payoutDetailsUpdatedAt       DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  user            User?                @relation(fields: [userId], references: [id])
  properties      ManagedProperty[]
  documents       TenantDocument[]
  statements      LandlordStatement[]
  createdTenants  Tenant[]
  settlements     LandlordSettlement[]
  reminderSetting RentReminderSetting?

  @@index([userId])
}

model ManagedProperty {
  id             String                 @id @default(cuid())
  ownerId        String
  name           String
  addressLine    String
  city           String
  state          String?
  country        String                 @default("NG")
  propertyType   RentalPropertyType
  imageUrls      String[]               @default([])
  notes          String?
  // Gates whether an assigned manager can approve/reject/counter a rental
  // application outright, or must route the decision to the owner (see
  // ApplicationDecision and the leasing dashboard's owner-approval queue).
  approvalPolicy PropertyApprovalPolicy @default(MANAGER_CAN_APPROVE)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  owner               PropertyOwner                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  units               RentalUnit[]
  managers            PropertyManager[]
  inspections         PropertyInspection[]
  maintenanceRequests MaintenanceRequest[]
  statements          LandlordStatement[]
  charges             TenantCharge[]
  managementAgreement ManagementAgreement?
  settlements         LandlordSettlement[]
  listings            RentalListing[]
  shortletAssignments ShortletPropertyAssignment[]
  shortletListings    ShortletListing[]

  @@index([ownerId])
}

// A User granted management access to one property. Authorization checks
// must always go through this table — a property manager only ever sees
// properties they're explicitly assigned to, never a landlord's full
// portfolio by default.
model PropertyManager {
  id         String   @id @default(cuid())
  propertyId String
  userId     String
  createdAt  DateTime @default(now())

  property ManagedProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([propertyId, userId])
  @@index([userId])
}

model RentalUnit {
  id                   String           @id @default(cuid())
  propertyId           String
  label                String
  bedrooms             Int?
  bathrooms            Int?
  unitType             String?
  rentAmountMinor      Int
  rentFrequency        RentFrequency    @default(ANNUAL)
  serviceChargeMinor   Int              @default(0)
  securityDepositMinor Int              @default(0)
  status               RentalUnitStatus @default(VACANT)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  property            ManagedProperty      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenants             Tenant[]
  leases              Lease[]
  inspections         PropertyInspection[]
  maintenanceRequests MaintenanceRequest[]
  moveIns             MoveIn[]
  moveOuts            MoveOut[]
  charges             TenantCharge[]
  listings            RentalListing[]
  viewings            Viewing[]
  reservations        UnitReservation[]
  offers              RentalOffer[]
  shortletListing     ShortletListing?

  @@index([propertyId])
}

// The tenant's current unit (unitId) is a convenience pointer — historical
// occupancy lives in Lease rows, which are never deleted or overwritten on
// renewal or move-out.
model Tenant {
  id                    String       @id @default(cuid())
  userId                String?      @unique
  unitId                String?
  // Set at creation to the acting landlord's PropertyOwner id. A tenant has
  // no other ownership link until a lease assigns them a unit (e.g. an
  // APPLICANT who hasn't moved in yet), so without this field an
  // unassigned tenant would be invisible to its own creator — or worse,
  // visible to every landlord — once queries scope by unit->property->owner.
  createdByOwnerId      String?
  fullName              String
  email                 String?
  phone                 String?
  whatsapp              String?
  emergencyContactName  String?
  emergencyContactPhone String?
  moveInDate            DateTime?
  status                TenantStatus @default(APPLICANT)
  notes                 String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  unit                RentalUnit?          @relation(fields: [unitId], references: [id])
  user                User?                @relation(fields: [userId], references: [id])
  createdByOwner      PropertyOwner?       @relation(fields: [createdByOwnerId], references: [id])
  leases              Lease[]
  documents           TenantDocument[]
  payments            RentPayment[]
  charges             TenantCharge[]
  maintenanceRequests MaintenanceRequest[]
  moveIns             MoveIn[]
  moveOuts            MoveOut[]

  @@index([unitId])
  @@index([userId])
  @@index([createdByOwnerId])
}

model Lease {
  id                   String              @id @default(cuid())
  leaseCode            String              @unique
  tenantId             String
  unitId               String
  startDate            DateTime
  endDate              DateTime
  rentAmountMinor      Int
  paymentFrequency     RentFrequency
  securityDepositMinor Int                 @default(0)
  serviceChargeMinor   Int                 @default(0)
  // Day-of-period rent is due (e.g. 1 = due on the 1st of each period).
  rentDueDay           Int                 @default(1)
  gracePeriodDays      Int                 @default(0)
  renewalTerms         String?
  documentUrl          String?
  status               LeaseStatus         @default(DRAFT)
  // The signing workflow, distinct from status above (which tracks
  // occupancy) — a lease can be DRAFT (occupancy) while its document is
  // already SIGNED, the moment before move-in flips occupancy to ACTIVE.
  documentStatus       LeaseDocumentStatus @default(DRAFT)
  signatureProvider    SignatureProvider?
  sentToTenantAt       DateTime?
  signedAt             DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  tenant             Tenant           @relation(fields: [tenantId], references: [id])
  unit               RentalUnit       @relation(fields: [unitId], references: [id])
  obligations        RentObligation[]
  payments           RentPayment[]
  charges            TenantCharge[]
  documents          TenantDocument[]
  moveIns            MoveIn[]
  moveOuts           MoveOut[]
  renewalsAsPrevious LeaseRenewal[]   @relation("RenewalPrevious")
  renewalAsNew       LeaseRenewal?    @relation("RenewalNew")
  offer              RentalOffer?

  @@index([tenantId])
  @@index([unitId])
}

// The explicit renewal event — links an old lease to the new one it became.
// The old Lease row is never modified beyond its status (e.g. → EXPIRED);
// its rent/dates/deposit stay exactly as originally recorded.
model LeaseRenewal {
  id              String   @id @default(cuid())
  previousLeaseId String
  newLeaseId      String   @unique
  renewedByUserId String?
  notes           String?
  createdAt       DateTime @default(now())

  previousLease Lease @relation("RenewalPrevious", fields: [previousLeaseId], references: [id])
  newLease      Lease @relation("RenewalNew", fields: [newLeaseId], references: [id])

  @@index([previousLeaseId])
}

// Every expected rent payment is its own row, recorded separately from
// actual payments received — this is what makes partial payments and
// arrears tracking correct instead of a single "is this period paid"
// boolean on the lease.
model RentObligation {
  id                  String               @id @default(cuid())
  leaseId             String
  periodStart         DateTime
  periodEnd           DateTime
  dueDate             DateTime
  // The amount as originally billed — never mutated once created, even
  // when a waiver or correction changes what's actually owed. amountDueMinor
  // stays the operative "what's owed now" figure (originalAmountMinor +
  // adjustmentsMinor) so every existing read site keeps working unchanged;
  // originalAmountMinor exists purely so a landlord can always see what an
  // adjustment was measured against.
  originalAmountMinor Int
  adjustmentsMinor    Int                  @default(0)
  amountDueMinor      Int
  amountPaidMinor     Int                  @default(0)
  status              RentObligationStatus @default(UPCOMING)
  notes               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  lease        Lease               @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  payments     RentPayment[]
  allocations  PaymentAllocation[]
  reminderLogs RentReminderLog[]

  @@index([leaseId])
  @@index([status])
}

model RentPayment {
  id                String            @id @default(cuid())
  referenceNumber   String            @unique
  tenantId          String
  leaseId           String
  // Legacy single-obligation pointer — kept so every existing query that
  // reads `obligationId` directly keeps working unchanged. The source of
  // truth for what a payment actually covers (which can now be more than
  // one obligation and/or Charge) is the `allocations` relation below;
  // this field is always kept equal to the first/primary allocation's
  // obligation for a rent-only payment.
  obligationId      String?
  amountMinor       Int
  paidAt            DateTime          @default(now())
  method            RentPaymentMethod
  transactionRef    String?
  // Paystack's own transaction reference — unique across the whole table
  // (unlike transactionRef, which is a free-text field for manual payments
  // and can't be assumed unique). This is what the webhook looks up by,
  // and initializing a duplicate reference is rejected before Paystack is
  // ever called.
  gatewayReference  String?           @unique
  status            RentPaymentStatus @default(COMPLETED)
  recordedByUserId  String?
  notes             String?
  proofOfPaymentUrl String?
  reversedAt        DateTime?
  reversedByUserId  String?
  reversalReason    String?
  createdAt         DateTime          @default(now())

  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  lease       Lease               @relation(fields: [leaseId], references: [id])
  obligation  RentObligation?     @relation(fields: [obligationId], references: [id])
  receipt     RentReceipt?
  allocations PaymentAllocation[]

  @@index([tenantId])
  @@index([leaseId])
  @@index([obligationId])
  @@index([status])
}

// Immutable once issued — a correction never edits a receipt's numbers,
// it goes through reversePayment() instead, which creates its own
// reversal trail without touching this row. See payments.ts.
model RentReceipt {
  id            String   @id @default(cuid())
  paymentId     String   @unique
  receiptNumber String   @unique
  createdAt     DateTime @default(now())

  payment RentPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

// A non-rent billable item — service charge, deposit, utility, maintenance
// recharge, late fee, or a one-off "other" charge. Rent itself is never
// modeled here; it stays on RentObligation, which drives lease/occupancy
// status in ways a generic charge shouldn't.
model TenantCharge {
  id              String             @id @default(cuid())
  tenantId        String
  propertyId      String
  unitId          String?
  leaseId         String?
  type            RentalChargeType
  amountMinor     Int
  amountPaidMinor Int                @default(0)
  dueDate         DateTime
  description     String
  status          RentalChargeStatus @default(PENDING)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  property    ManagedProperty     @relation(fields: [propertyId], references: [id])
  unit        RentalUnit?         @relation(fields: [unitId], references: [id])
  lease       Lease?              @relation(fields: [leaseId], references: [id])
  allocations PaymentAllocation[]

  @@index([tenantId])
  @@index([propertyId])
  @@index([status])
}

// Lets one Payment cover more than one billable thing (e.g. ₦50,000 rent +
// ₦10,000 service charge in a single bank transfer) — the sum of a
// payment's allocations always equals that payment's amountMinor.
// Exactly one of rentObligationId/chargeId is set per row (enforced in
// payments.ts, not at the DB level, since Prisma has no portable XOR
// constraint).
model PaymentAllocation {
  id               String   @id @default(cuid())
  paymentId        String
  rentObligationId String?
  chargeId         String?
  amountMinor      Int
  createdAt        DateTime @default(now())

  payment        RentPayment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  rentObligation RentObligation? @relation(fields: [rentObligationId], references: [id])
  charge         TenantCharge?   @relation(fields: [chargeId], references: [id])

  @@index([paymentId])
  @@index([rentObligationId])
  @@index([chargeId])
}

// One agreement per property, kept entirely separate from the tenant's
// Lease — a management fee is a landlord/manager arrangement, never
// something a tenant's rent obligation is adjusted for.
model ManagementAgreement {
  id             String            @id @default(cuid())
  propertyId     String            @unique
  feeType        ManagementFeeType
  // Percentage fees are stored in basis points (1000 = 10.00%) to stay
  // integer/decimal-safe — never a floating-point percentage.
  feeBasisPoints Int?
  feeAmountMinor Int?
  effectiveFrom  DateTime          @default(now())
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  property ManagedProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

// The formal, stateful "we owe the landlord this much" record — distinct
// from LandlordStatement, which is a read-only computed report. A
// settlement is generated FROM the same underlying ledger (payments +
// management fee + expenses) but then has its own approval/payment
// workflow that a statement doesn't.
model LandlordSettlement {
  id                    String                   @id @default(cuid())
  ownerId               String
  propertyId            String?
  periodStart           DateTime
  periodEnd             DateTime
  grossCollectionsMinor Int
  managementFeeMinor    Int                      @default(0)
  expensesMinor         Int                      @default(0)
  adjustmentsMinor      Int                      @default(0)
  netAmountMinor        Int
  settlementDate        DateTime?
  paymentReference      String?
  status                LandlordSettlementStatus @default(PENDING)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  owner    PropertyOwner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  property ManagedProperty? @relation(fields: [propertyId], references: [id])

  @@index([ownerId])
  @@index([propertyId])
}

// One row per landlord — applies to every lease in their portfolio unless
// a future per-lease override is added. Presets match the phase-2 spec's
// suggested defaults; `beforeDueDays`/`afterDueDays` accept any custom
// values too.
model RentReminderSetting {
  id            String   @id @default(cuid())
  ownerId       String   @unique
  beforeDueDays Int[]    @default([30, 14, 7])
  afterDueDays  Int[]    @default([1, 7, 14, 30])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner PropertyOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

// One row per (obligation, direction, offsetDays) ever sent — the unique
// constraint is what makes re-running the reminder sweep idempotent: a
// reminder already logged for that exact threshold is never sent twice.
model RentReminderLog {
  id           String              @id @default(cuid())
  obligationId String
  direction    ReminderDirection
  offsetDays   Int
  channel      NotificationChannel
  sentAt       DateTime            @default(now())

  obligation RentObligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)

  @@unique([obligationId, direction, offsetDays])
  @@index([obligationId])
}

// One row per webhook delivery Paystack makes for a given
// (reference, event) pair — Paystack retries webhooks that don't 2xx
// quickly enough, so this is checked before any ledger-mutating work
// happens, independent of the RentPayment.status idempotency check.
model PaystackWebhookEvent {
  id         String   @id @default(cuid())
  reference  String
  eventType  String
  receivedAt DateTime @default(now())

  @@unique([reference, eventType])
}

// Polymorphic-by-nullable-FK: a document belongs to exactly one of
// tenant/lease/owner. Kept as one model rather than three near-identical
// ones since the shape (label, file, type) is identical in every case.
model TenantDocument {
  id              String   @id @default(cuid())
  tenantId        String?
  leaseId         String?
  propertyOwnerId String?
  label           String
  fileUrl         String
  documentType    String?
  createdAt       DateTime @default(now())

  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lease         Lease?         @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  propertyOwner PropertyOwner? @relation(fields: [propertyOwnerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([leaseId])
  @@index([propertyOwnerId])
}

model PropertyInspection {
  id              String                 @id @default(cuid())
  propertyId      String
  unitId          String?
  type            PropertyInspectionType
  inspectorUserId String?
  notes           String?
  issuesFound     String?
  photoUrls       String[]               @default([])
  inspectedAt     DateTime               @default(now())
  createdAt       DateTime               @default(now())

  property ManagedProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit     RentalUnit?     @relation(fields: [unitId], references: [id])

  @@index([propertyId])
  @@index([unitId])
}

model MaintenanceRequest {
  id                     String                    @id @default(cuid())
  requestCode            String                    @unique
  propertyId             String
  unitId                 String
  tenantId               String?
  category               RentalMaintenanceCategory
  description            String
  priority               RentalMaintenancePriority @default(MEDIUM)
  status                 RentalMaintenanceStatus   @default(SUBMITTED)
  permissionToEnter      Boolean                   @default(false)
  preferredContactMethod String?
  photoUrls              String[]                  @default([])
  vendorName             String?
  assignedAt             DateTime?
  completedAt            DateTime?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  property ManagedProperty      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit     RentalUnit           @relation(fields: [unitId], references: [id])
  tenant   Tenant?              @relation(fields: [tenantId], references: [id])
  expenses MaintenanceExpense[]

  @@index([propertyId])
  @@index([unitId])
  @@index([tenantId])
}

// Feeds landlord statements — every cost tied to a maintenance request
// rolls up into Property -> Unit -> MaintenanceRequest -> expense.
model MaintenanceExpense {
  id                  String   @id @default(cuid())
  requestId           String
  vendorName          String
  description         String
  estimateMinor       Int?
  approvedAmountMinor Int?
  finalAmountMinor    Int?
  isPaid              Boolean  @default(false)
  invoiceUrl          String?
  receiptUrl          String?
  createdAt           DateTime @default(now())

  request MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model LandlordStatement {
  id                String   @id @default(cuid())
  ownerId           String
  propertyId        String?
  periodMonth       Int
  periodYear        Int
  totalIncomeMinor  Int
  totalExpenseMinor Int
  netAmountMinor    Int
  createdAt         DateTime @default(now())

  owner        PropertyOwner          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  property     ManagedProperty?       @relation(fields: [propertyId], references: [id])
  transactions StatementTransaction[]

  @@unique([ownerId, propertyId, periodMonth, periodYear])
  @@index([ownerId])
  @@index([propertyId])
}

model StatementTransaction {
  id          String   @id @default(cuid())
  statementId String
  // "INCOME" | "EXPENSE" — kept as a plain string rather than a two-value
  // enum; the category field carries the real detail (Rent, Management Fee,
  // Maintenance, etc.) and doesn't need a fixed vocabulary yet.
  type        String
  category    String
  description String
  amountMinor Int
  occurredAt  DateTime
  createdAt   DateTime @default(now())

  statement LandlordStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@index([statementId])
}

model MoveIn {
  id                String      @id @default(cuid())
  tenantId          String
  leaseId           String
  unitId            String
  stage             MoveInStage @default(STARTED)
  depositRecordedAt DateTime?
  rentRecordedAt    DateTime?
  inspectionDoneAt  DateTime?
  keysIssuedAt      DateTime?
  completedAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  lease     Lease            @relation(fields: [leaseId], references: [id])
  unit      RentalUnit       @relation(fields: [unitId], references: [id])
  readiness MoveInReadiness?

  @@index([tenantId])
  @@index([leaseId])
}

model MoveOut {
  id                   String       @id @default(cuid())
  tenantId             String
  leaseId              String
  unitId               String
  stage                MoveOutStage @default(NOTICE_RECEIVED)
  noticeDate           DateTime?
  moveOutDate          DateTime?
  finalBalanceMinor    Int?
  depositReturnedMinor Int?
  inspectionDoneAt     DateTime?
  keysReturnedAt       DateTime?
  completedAt          DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  tenant Tenant     @relation(fields: [tenantId], references: [id])
  lease  Lease      @relation(fields: [leaseId], references: [id])
  unit   RentalUnit @relation(fields: [unitId], references: [id])

  @@index([tenantId])
  @@index([leaseId])
}

// ---------------------------------------------------------------------------
// Phase 3 -- Tenant Acquisition & Leasing.
//
// Vacant Unit -> Listing -> Inquiry -> Viewing -> Application -> Screening ->
// Decision -> Offer -> Reservation -> Lease -> Move-In -> Active Tenant.
//
// Deliberately reuses every model from earlier phases wherever the shape
// already fits: RentalUnit.status carries VACANT/RESERVED/OCCUPIED (no new
// vacancy-status field needed on the unit itself -- see ListingStatus for
// the listing's own lifecycle, which is a separate concept from the unit's
// occupancy), Lease/RentObligation/RentPayment/PaymentAllocation remain the
// one financial ledger (a lease generated from an accepted offer is
// created through the exact same createLease() as any other lease),
// PropertyInspection covers the move-in inspection, and TenantDocument
// continues to hold documents once someone is an actual Tenant.
// RentalApplicant is the only genuinely new "person" concept -- an
// applicant is not a Tenant until convertApplicantToTenant() runs, so a
// prospect never gets estate/portal access before being approved and
// leased.
// ---------------------------------------------------------------------------

enum ListingStatus {
  NOT_LISTED
  DRAFT
  AVAILABLE
  APPLICATIONS_OPEN
  UNDER_OFFER
  RESERVED
  LEASED
  WITHDRAWN
}

enum FurnishedStatus {
  UNFURNISHED
  SEMI_FURNISHED
  FURNISHED
}

enum InquiryStatus {
  NEW
  CONTACTED
  VIEWING_SCHEDULED
  APPLICATION_STARTED
  APPLICATION_SUBMITTED
  CLOSED
}

enum ViewingType {
  PHYSICAL
  VIDEO
}

enum ViewingStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  NO_SHOW
  CANCELLED
}

// A single enum spans both the pre-submission draft states (STARTED/
// INCOMPLETE/SUBMITTED -- only the applicant sees these) and the manager's
// Kanban pipeline (REVIEWING onward) so an application's status is always
// one unambiguous value rather than two parallel fields that could drift
// out of sync.
enum ApplicationStatus {
  STARTED
  INCOMPLETE
  SUBMITTED
  REVIEWING
  INFORMATION_REQUIRED
  SCREENING
  VIEWING
  APPROVED
  OFFER_SENT
  LEASE_PENDING
  LEASE_SIGNED
  REJECTED
  WITHDRAWN
}

enum ScreeningItemStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
  ISSUE_FOUND
  NOT_APPLICABLE
}

// The fixed checklist from the phase-3 spec -- a closed set rather than a
// free-text checkType, so every application gets the same checklist and
// nothing can be silently skipped by a typo.
enum ScreeningCheckType {
  IDENTITY
  INCOME_DOCUMENTATION
  EMPLOYMENT_VERIFICATION
  PREVIOUS_LANDLORD_REFERENCE
  DOCUMENTATION_COMPLETE
  VIEWING_COMPLETED
  MANAGER_REVIEW
  OWNER_APPROVAL
}

// A decision is an event, never a mutable field -- see ApplicationDecision.
// Every status change on the application itself still happens too (for
// the Kanban view), but the why and who live here permanently.
enum ApplicationDecisionType {
  APPROVE
  REQUEST_MORE_INFO
  REJECT
  WITHDRAWN
}

enum OfferStatus {
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

enum UnitReservationStatus {
  ACTIVE
  RELEASED
  CONVERTED_TO_LEASE
  EXPIRED
}

// The document workflow (has it been drafted, sent, signed) -- distinct
// from Lease.status, which tracks occupancy (ACTIVE/EXPIRED/TERMINATED).
// A lease can be LeaseStatus.DRAFT while its document is already SIGNED,
// the moment before move-in flips occupancy to ACTIVE.
enum LeaseDocumentStatus {
  DRAFT
  UNDER_REVIEW
  SENT_TO_TENANT
  PENDING_SIGNATURE
  SIGNED
  ACTIVE
  CANCELLED
}

// Provider abstraction only -- see leaseSignature.ts. MANUAL_UPLOAD (a
// signed PDF uploaded by staff) is the only one actually wired up;
// DOCUSIGN/OTHER exist so a real e-signature integration has somewhere to
// plug in later without a schema change.
enum SignatureProvider {
  MANUAL_UPLOAD
  DOCUSIGN
  OTHER
}

// Per-property setting (section 26) -- a diaspora landlord who wants final
// say on every new tenant sets OWNER_APPROVAL_REQUIRED; otherwise the
// assigned manager can approve applications outright.
enum PropertyApprovalPolicy {
  MANAGER_CAN_APPROVE
  OWNER_APPROVAL_REQUIRED
}

// A public-facing rental listing generated from an existing RentalUnit.
// Deliberately NOT unique-per-unit: closing one listing (WITHDRAWN/LEASED)
// and creating a fresh row for the next vacancy cycle keeps each cycle's
// inquiry/viewing/application counts (see vacancyPerformance.ts) separate
// instead of accumulating forever against one row.
model RentalListing {
  id                       String          @id @default(cuid())
  listingReference         String          @unique
  unitId                   String
  propertyId               String
  title                    String
  description              String
  rentAmountMinor          Int
  rentFrequency            RentFrequency
  serviceChargeMinor       Int             @default(0)
  securityDepositMinor     Int             @default(0)
  bedrooms                 Int?
  bathrooms                Int?
  furnishedStatus          FurnishedStatus @default(UNFURNISHED)
  availableDate            DateTime
  amenities                String[]        @default([])
  rules                    String?
  imageUrls                String[]        @default([])
  videoUrls                String[]        @default([])
  displayArea              String?
  viewingAvailabilityNotes String?
  status                   ListingStatus   @default(DRAFT)
  publishedAt              DateTime?
  withdrawnAt              DateTime?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  unit         RentalUnit          @relation(fields: [unitId], references: [id])
  property     ManagedProperty     @relation(fields: [propertyId], references: [id])
  inquiries    RentalInquiry[]
  viewings     Viewing[]
  applications RentalApplication[]
  offers       RentalOffer[]

  @@index([unitId])
  @@index([propertyId])
  @@index([status])
}

// One base profile per prospective tenant, reused across every listing
// they apply to (section 11) -- never duplicated just because they submit
// a second application. Distinct from Tenant: an applicant only becomes a
// Tenant once convertApplicantToTenant() runs after a signed lease.
model RentalApplicant {
  id             String    @id @default(cuid())
  userId         String?   @unique
  fullName       String
  email          String?
  phone          String?
  whatsapp       String?
  dateOfBirth    DateTime?
  currentAddress String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User?               @relation(fields: [userId], references: [id])
  inquiries    RentalInquiry[]
  viewings     Viewing[]
  applications RentalApplication[]
  reservations UnitReservation[]

  @@index([userId])
  @@index([email])
  @@index([phone])
}

model RentalInquiry {
  id                  String        @id @default(cuid())
  listingId           String
  applicantId         String?
  name                String
  email               String?
  phone               String?
  whatsapp            String?
  preferredMoveInDate DateTime?
  message             String?
  status              InquiryStatus @default(NEW)
  assignedToUserId    String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  listing   RentalListing    @relation(fields: [listingId], references: [id])
  applicant RentalApplicant? @relation(fields: [applicantId], references: [id])

  @@index([listingId])
  @@index([status])
}

model Viewing {
  id                 String        @id @default(cuid())
  listingId          String
  unitId             String
  applicantId        String?
  type               ViewingType   @default(PHYSICAL)
  preferredDate      DateTime
  preferredTime      String?
  alternativeDate    DateTime?
  alternativeTime    String?
  notes              String?
  status             ViewingStatus @default(REQUESTED)
  confirmedAt        DateTime?
  attended           Boolean?
  interested         Boolean?
  applicationInvited Boolean?
  outcomeNotes       String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  listing   RentalListing    @relation(fields: [listingId], references: [id])
  unit      RentalUnit       @relation(fields: [unitId], references: [id])
  applicant RentalApplicant? @relation(fields: [applicantId], references: [id])

  @@index([listingId])
  @@index([unitId])
  @@index([status])
}

model RentalApplication {
  id                   String            @id @default(cuid())
  applicationReference String            @unique
  listingId            String
  applicantId          String
  status               ApplicationStatus @default(STARTED)

  fullName       String
  email          String?
  phone          String?
  whatsapp       String?
  dateOfBirth    DateTime?
  currentAddress String?

  employmentStatus         String?
  employerName             String?
  occupation               String?
  incomeRange              String?
  employmentDurationMonths Int?

  preferredMoveInDate         DateTime?
  occupantsCount              Int?
  intendedLeaseDurationMonths Int?

  currentHousingStatus    String?
  previousLandlordName    String?
  previousLandlordContact String?

  emergencyContactName  String?
  emergencyContactPhone String?

  assignedToUserId String?
  submittedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  listing        RentalListing          @relation(fields: [listingId], references: [id])
  applicant      RentalApplicant        @relation(fields: [applicantId], references: [id])
  documents      ApplicationDocument[]
  screeningItems ApplicationScreening[]
  decisions      ApplicationDecision[]
  notes          ApplicationNote[]
  offers         RentalOffer[]

  @@index([listingId])
  @@index([applicantId])
  @@index([status])
}

// Deliberately its own model rather than reusing TenantDocument -- an
// applicant is not a Tenant yet, and application documents (payslips, ID,
// references) have different retention/authorization needs than a signed
// tenant's lease/receipt documents.
model ApplicationDocument {
  id            String   @id @default(cuid())
  applicationId String
  label         String
  fileUrl       String
  documentType  String?
  createdAt     DateTime @default(now())

  application RentalApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

// One row per ScreeningCheckType per application (enforced by the unique
// constraint) -- the checklist is seeded with NOT_STARTED rows for every
// check type when an application enters screening, so nothing can be
// silently skipped. Never used to auto-approve/reject -- advancing status
// is always a separate, human action.
model ApplicationScreening {
  id               String              @id @default(cuid())
  applicationId    String
  checkType        ScreeningCheckType
  status           ScreeningItemStatus @default(NOT_STARTED)
  notes            String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  application RentalApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, checkType])
  @@index([applicationId])
}

// Internal-only -- never shown to the applicant unless explicitly shared
// through some future feature. Authorization for who may read these
// follows the same property-scoping as every other Tenant Management
// record (see access.ts).
model ApplicationNote {
  id            String   @id @default(cuid())
  applicationId String
  authorUserId  String
  body          String
  createdAt     DateTime @default(now())

  application RentalApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

// The permanent decision trail (section 14) -- an application's status
// field can change many times, but every APPROVE/REQUEST_MORE_INFO/
// REJECT/WITHDRAWN event is preserved here with its reason, forever. An
// application is never deleted, even when rejected.
model ApplicationDecision {
  id              String                  @id @default(cuid())
  applicationId   String
  decision        ApplicationDecisionType
  reason          String
  decidedByUserId String
  createdAt       DateTime                @default(now())

  application RentalApplication @relation(fields: [applicationId], references: [id])

  @@index([applicationId])
}

model RentalOffer {
  id                   String        @id @default(cuid())
  offerReference       String        @unique
  applicationId        String
  listingId            String
  unitId               String
  rentAmountMinor      Int
  paymentFrequency     RentFrequency
  serviceChargeMinor   Int           @default(0)
  securityDepositMinor Int           @default(0)
  leaseDurationMonths  Int
  proposedStartDate    DateTime
  expiresAt            DateTime
  specialConditions    String?
  status               OfferStatus   @default(SENT)
  respondedAt          DateTime?
  declineReason        String?
  createdByUserId      String
  leaseId              String?       @unique
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  application RentalApplication @relation(fields: [applicationId], references: [id])
  listing     RentalListing     @relation(fields: [listingId], references: [id])
  unit        RentalUnit        @relation(fields: [unitId], references: [id])
  lease       Lease?            @relation(fields: [leaseId], references: [id])
  reservation UnitReservation?

  @@index([applicationId])
  @@index([listingId])
  @@index([status])
}

// The event log behind "prevent multiple finalized leases for the same
// unit/date range" (section 16) -- createLease() checks for an ACTIVE
// reservation belonging to someone else before allowing a new one, and
// generateLeaseFromOffer() flips this to CONVERTED_TO_LEASE rather than
// deleting it, so the reservation history survives.
model UnitReservation {
  id            String                @id @default(cuid())
  unitId        String
  offerId       String?               @unique
  applicantId   String?
  status        UnitReservationStatus @default(ACTIVE)
  reservedFrom  DateTime              @default(now())
  reservedUntil DateTime?
  releasedAt    DateTime?
  createdAt     DateTime              @default(now())

  unit      RentalUnit       @relation(fields: [unitId], references: [id])
  offer     RentalOffer?     @relation(fields: [offerId], references: [id])
  applicant RentalApplicant? @relation(fields: [applicantId], references: [id])

  @@index([unitId])
  @@index([status])
}

// The granular move-in readiness checklist from section 21 -- one row per
// MoveIn, distinct from MoveIn.stage (which tracks the guided workflow's
// coarse stages). An item can only be marked complete normally by the
// underlying fact becoming true (lease signed, deposit payment recorded,
// etc.) except through an explicit, audited override.
model MoveInReadiness {
  id                         String   @id @default(cuid())
  moveInId                   String   @unique
  leaseSigned                Boolean  @default(false)
  depositPaid                Boolean  @default(false)
  initialRentPaid            Boolean  @default(false)
  documentsComplete          Boolean  @default(false)
  moveInDateConfirmed        Boolean  @default(false)
  inspectionScheduled        Boolean  @default(false)
  keysPrepared               Boolean  @default(false)
  estateRegistrationRequired Boolean  @default(false)
  estateRegistrationComplete Boolean  @default(false)
  utilitiesSetupRequired     Boolean  @default(false)
  utilitiesSetupComplete     Boolean  @default(false)
  overriddenItems            String[] @default([])
  overrideReason             String?
  overriddenByUserId         String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  moveIn MoveIn @relation(fields: [moveInId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// NidraQ Shortlet Management -- a first-class standalone module (foundation
// pass: core booking engine), NOT a Tenant Management submodule and NOT the
// same thing as the earlier estate-hosted Shortlet feature under
// Estate/ShortletProperty/Reservation above. That estate-hosted feature is
// left running as-is; this is the new estate-independent hierarchy:
//
//   ShortletOperator -> (via ShortletPropertyAssignment) ManagedProperty ->
//   RentalUnit -> ShortletListing -> ShortletBooking -> ShortletGuest
//
// Deliberately reuses ManagedProperty/RentalUnit/User/PropertyOwner rather
// than a parallel property/unit tree -- the same physical unit can move
// between Tenant Management and Shortlet Management over time (or
// participate in neither), and its ownership/maintenance/inspection history
// stays on the one RentalUnit row regardless of which module is currently
// using it. RentPaymentMethod is reused for BookingPayment.method for the
// same reason. ShortletGuest is intentionally its own model, never the
// long-term Tenant model, and ShortletBooking is never a Lease.
// ---------------------------------------------------------------------------

enum ShortletListingStatus {
  DRAFT
  ACTIVE
  INACTIVE
  MAINTENANCE
  UNAVAILABLE
}

enum RatePlanType {
  DEFAULT
  WEEKEND
  SEASONAL
  DATE_SPECIFIC
}

enum ShortletBookingStatus {
  INQUIRY
  PENDING
  AWAITING_PAYMENT
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingChargeType {
  ACCOMMODATION
  CLEANING_FEE
  SECURITY_DEPOSIT
  ADDITIONAL_GUEST_FEE
  DISCOUNT
  TAX
  OTHER
}

enum BookingPaymentStatus {
  COMPLETED
  PENDING
  FAILED
  REVERSED
}

// Distinct name from the estate-hosted AvailabilityBlockReason above --
// separate module, separate enum, even though the concept overlaps.
enum ShortletAvailabilityBlockReason {
  OWNER_BLOCKED
  MAINTENANCE
  TURNOVER
  OTHER
}

// The management-company/host layer sitting above ManagedProperty -- a User
// "is" a shortlet operator purely via this row's userId, the same
// derived-role pattern as PropertyOwner/Tenant/RentalApplicant elsewhere in
// the schema.
model ShortletOperator {
  id           String   @id @default(cuid())
  userId       String?  @unique
  name         String
  contactEmail String?
  contactPhone String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user                User?                        @relation(fields: [userId], references: [id])
  propertyAssignments ShortletPropertyAssignment[]
  listings            ShortletListing[]
}

// An operator's mandate to run shortlet operations on a given property --
// independent of whether that same property also has a Tenant Management
// PropertyManager assigned. A property can have both, neither, or either.
model ShortletPropertyAssignment {
  id         String   @id @default(cuid())
  operatorId String
  propertyId String
  createdAt  DateTime @default(now())

  operator ShortletOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  property ManagedProperty  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([operatorId, propertyId])
  @@index([propertyId])
}

// The bookable shortlet configuration for one RentalUnit -- one listing per
// unit at a time (the unique unitId). Deliberately separate from the
// long-term RentalListing (Tenant Management) even though both extend the
// same RentalUnit, since nightly-rate/house-rules/max-guest fields have no
// meaning for a long-term lease and vice versa.
model ShortletListing {
  id                   String                @id @default(cuid())
  listingReference     String                @unique
  unitId               String                @unique
  propertyId           String
  operatorId           String
  title                String
  description          String
  bedrooms             Int?
  bathrooms            Int?
  maxGuests            Int
  amenities            String[]              @default([])
  imageUrls            String[]              @default([])
  houseRules           String?
  checkInTime          String
  checkOutTime         String
  baseNightlyRateMinor Int
  cleaningFeeMinor     Int                   @default(0)
  securityDepositMinor Int                   @default(0)
  minStayNights        Int                   @default(1)
  maxStayNights        Int?
  status               ShortletListingStatus @default(DRAFT)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  unit               RentalUnit                  @relation(fields: [unitId], references: [id])
  property           ManagedProperty             @relation(fields: [propertyId], references: [id])
  operator           ShortletOperator            @relation(fields: [operatorId], references: [id])
  ratePlans          RatePlan[]
  bookings           ShortletBooking[]
  availabilityBlocks ShortletAvailabilityBlock[]
  ownerStays         OwnerStay[]

  @@index([propertyId])
  @@index([operatorId])
  @@index([status])
}

// Weekend/seasonal/date-specific overrides on top of a listing's own
// baseNightlyRateMinor. A booking snapshots whatever rate applied at the
// time it was made onto ShortletBooking.nightlyRateMinor -- changing a
// RatePlan later never rewrites a past booking's price.
model RatePlan {
  id               String       @id @default(cuid())
  listingId        String
  type             RatePlanType
  label            String?
  startDate        DateTime?
  endDate          DateTime?
  // 0=Sunday .. 6=Saturday -- only meaningful for type WEEKEND.
  daysOfWeek       Int[]        @default([])
  nightlyRateMinor Int
  minStayNights    Int?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  listing ShortletListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

// Never the long-term Tenant model -- a shortlet guest has no lease, no
// unit assignment, no rent obligations. Deduplicated the same way
// RentalApplicant is (by userId, then email, then phone) so a repeat guest
// across many bookings gets one profile.
model ShortletGuest {
  id                    String   @id @default(cuid())
  userId                String?  @unique
  fullName              String
  email                 String?
  phone                 String?
  whatsapp              String?
  country               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user     User?             @relation(fields: [userId], references: [id])
  bookings ShortletBooking[]

  @@index([userId])
  @@index([email])
  @@index([phone])
}

model ShortletBooking {
  id                   String                @id @default(cuid())
  bookingReference     String                @unique
  listingId            String
  guestId              String
  checkInDate          DateTime
  checkOutDate         DateTime
  numberOfGuests       Int
  nights               Int
  // Snapshot at booking time -- see the RatePlan model comment.
  nightlyRateMinor     Int
  cleaningFeeMinor     Int                   @default(0)
  securityDepositMinor Int                   @default(0)
  discountMinor        Int                   @default(0)
  additionalFeesMinor  Int                   @default(0)
  totalAmountMinor     Int
  amountPaidMinor      Int                   @default(0)
  status               ShortletBookingStatus @default(INQUIRY)
  bookingSource        ShortletBookingSource
  notes                String?
  createdByUserId      String?
  checkedInAt          DateTime?
  checkedOutAt         DateTime?
  // Cheap, additive columns for future channel-manager sync (Airbnb,
  // Booking.com) -- no integration logic exists yet; see section 13 of the
  // Shortlet spec. Never populated by anything in this codebase today.
  externalBookingId    String?
  externalChannel      String?
  syncStatus           String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  listing          ShortletListing  @relation(fields: [listingId], references: [id])
  guest            ShortletGuest    @relation(fields: [guestId], references: [id])
  additionalGuests BookingGuest[]
  charges          BookingCharge[]
  payments         BookingPayment[]

  @@index([listingId])
  @@index([guestId])
  @@index([status])
  @@index([listingId, checkInDate, checkOutDate])
}

// A named additional occupant beyond the primary guest -- not a full
// ShortletGuest profile of their own.
model BookingGuest {
  id        String   @id @default(cuid())
  bookingId String
  fullName  String
  notes     String?
  createdAt DateTime @default(now())

  booking ShortletBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

// The itemized financial breakdown behind ShortletBooking's rolled-up
// totalAmountMinor -- accommodation, cleaning, additional-guest fees,
// discounts, taxes, and any other approved charge, each its own row so a
// booking's financial record stays fully auditable line by line.
model BookingCharge {
  id          String            @id @default(cuid())
  bookingId   String
  type        BookingChargeType
  description String
  amountMinor Int
  createdAt   DateTime          @default(now())

  booking ShortletBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

// The booking-scoped payment ledger -- deliberately its own model rather
// than RentPayment/PaymentAllocation (which are shaped around a Lease's
// recurring RentObligation schedule, not a single one-off stay), but reuses
// the existing RentPaymentMethod enum rather than inventing another one.
model BookingPayment {
  id               String               @id @default(cuid())
  bookingId        String
  amountMinor      Int
  method           RentPaymentMethod
  status           BookingPaymentStatus @default(COMPLETED)
  paidAt           DateTime             @default(now())
  transactionRef   String?
  notes            String?
  recordedByUserId String?
  createdAt        DateTime             @default(now())

  booking ShortletBooking @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
}

// A manual hold on a listing's calendar (owner-blocked, maintenance,
// turnover-in-progress) -- checked alongside ShortletBooking and OwnerStay
// by the availability engine so double-booking prevention is enforced
// server-side against every source of unavailability, not just other
// bookings.
model ShortletAvailabilityBlock {
  id              String                          @id @default(cuid())
  listingId       String
  startDate       DateTime
  endDate         DateTime
  reason          ShortletAvailabilityBlockReason
  notes           String?
  createdByUserId String?
  createdAt       DateTime                        @default(now())

  listing ShortletListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

// An owner using their own property for personal use -- blocks the
// calendar like a booking would, but is never counted as revenue or guest
// activity in any analytics/statement calculation.
model OwnerStay {
  id              String   @id @default(cuid())
  listingId       String
  startDate       DateTime
  endDate         DateTime
  notes           String?
  createdByUserId String?
  createdAt       DateTime @default(now())

  listing ShortletListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}
