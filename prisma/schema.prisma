generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  PLATFORM_SUPER_ADMIN
  ESTATE_ADMIN
  FINANCE
  FACILITY_MANAGER
  SECURITY
  RESIDENT
  VENDOR
}

enum PropertyType {
  DETACHED_HOUSE
  SEMI_DETACHED
  TERRACE
  FLAT_BLOCK
  COMMERCIAL
  LAND
  OTHER
}

enum OccupancyRole {
  OWNER
  TENANT
  HOUSEHOLD_MEMBER
}

enum OccupancyStatus {
  VACANT
  OCCUPIED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum ChargeType {
  SERVICE_CHARGE_ANNUAL
  SERVICE_CHARGE_MONTHLY
  SECURITY_LEVY
  ELECTRICITY
  WATER
  DIESEL
  INFRASTRUCTURE_LEVY
  SPECIAL_ASSESSMENT
  WASTE_COLLECTION
  OTHER
}

enum ChargeTargetType {
  ENTIRE_ESTATE
  BLOCK
  STREET
  PROPERTY_TYPE
  SELECTED_PROPERTIES
}

enum InvoiceStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  PAYSTACK_CARD
  PAYSTACK_TRANSFER
  PAYSTACK_USSD
  MANUAL_BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

// A User is an authenticatable identity. It may or may not be linked to a
// Resident profile, and may hold EstateMember roles in one or more estates.
model User {
  id              String   @id @default(cuid())
  email           String?  @unique
  phone           String?  @unique
  passwordHash    String?
  name            String
  isPlatformAdmin Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships   EstateMember[]
  residentLinks Resident[]
  auditLogs     AuditLog[]     @relation("ActorUser")
}

// ---------------------------------------------------------------------------
// Tenant root
// ---------------------------------------------------------------------------

model Estate {
  id                 String             @id @default(cuid())
  name               String
  slug               String             @unique
  logoUrl            String?
  address            String?
  city               String?
  state              String?
  contactEmail       String?
  contactPhone       String?
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  planId             String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  members    EstateMember[]
  blocks     Block[]
  streets    Street[]
  zones      Zone[]
  properties Property[]
  residents  Resident[]
  vehicles   Vehicle[]
  auditLogs  AuditLog[]
  charges    Charge[]
  invoices   Invoice[]
  payments   Payment[]
  receipts   Receipt[]
  sequences  EstateSequence[]

  @@index([subscriptionStatus])
}

// Grants a User a Role within a specific Estate. A user can belong to
// multiple estates (e.g. a facility-management company staff member).
model EstateMember {
  id        String   @id @default(cuid())
  estateId  String
  userId    String
  role      Role
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([estateId, userId, role])
  @@index([estateId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Estate geography
// ---------------------------------------------------------------------------

model Block {
  id        String   @id @default(cuid())
  estateId  String
  name      String
  createdAt DateTime @default(now())

  estate     Estate     @relation(fields: [estateId], references: [id], onDelete: Cascade)
  properties Property[]

  @@index([estateId])
}

model Street {
  id        String   @id @default(cuid())
  estateId  String
  name      String
  createdAt DateTime @default(now())

  estate     Estate     @relation(fields: [estateId], references: [id], onDelete: Cascade)
  properties Property[]

  @@index([estateId])
}

model Zone {
  id        String   @id @default(cuid())
  estateId  String
  name      String
  createdAt DateTime @default(now())

  estate     Estate     @relation(fields: [estateId], references: [id], onDelete: Cascade)
  properties Property[]

  @@index([estateId])
}

// ---------------------------------------------------------------------------
// Properties & Units
// ---------------------------------------------------------------------------

// An addressable structure (a duplex, a block of flats, a standalone house).
model Property {
  id           String       @id @default(cuid())
  estateId     String
  blockId      String?
  streetId     String?
  zoneId       String?
  addressLabel String
  propertyType PropertyType
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  estate Estate  @relation(fields: [estateId], references: [id], onDelete: Cascade)
  block  Block?  @relation(fields: [blockId], references: [id])
  street Street? @relation(fields: [streetId], references: [id])
  zone   Zone?   @relation(fields: [zoneId], references: [id])
  units  Unit[]

  @@index([estateId])
}

// The billable / occupiable sub-entity. A standalone house still gets one
// implicit Unit so billing and occupancy always attach to a Unit.
model Unit {
  id              String          @id @default(cuid())
  propertyId      String
  estateId        String
  label           String
  occupancyStatus OccupancyStatus @default(VACANT)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  occupancies Occupancy[]
  invoices    Invoice[]

  @@index([estateId])
  @@index([propertyId])
}

// ---------------------------------------------------------------------------
// Residents
// ---------------------------------------------------------------------------

// An estate-scoped profile. May or may not have a linked User (e.g. a
// household member with no login yet).
model Resident {
  id                    String   @id @default(cuid())
  estateId              String
  userId                String?
  firstName             String
  lastName              String
  email                 String?
  phone                 String?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  estate      Estate      @relation(fields: [estateId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id])
  occupancies Occupancy[]
  vehicles    Vehicle[]
  invoices    Invoice[]

  @@index([estateId])
  @@index([userId])
}

// History of which Resident occupies which Unit, and in what capacity.
model Occupancy {
  id          String        @id @default(cuid())
  unitId      String
  residentId  String
  role        OccupancyRole
  moveInDate  DateTime
  moveOutDate DateTime?
  isCurrent   Boolean       @default(true)
  createdAt   DateTime      @default(now())

  unit     Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  resident Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([unitId])
  @@index([residentId])
}

model Vehicle {
  id          String   @id @default(cuid())
  estateId    String
  residentId  String
  plateNumber String
  make        String?
  model       String?
  color       String?
  createdAt   DateTime @default(now())

  estate   Estate   @relation(fields: [estateId], references: [id], onDelete: Cascade)
  resident Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([estateId])
  @@index([residentId])
}

// ---------------------------------------------------------------------------
// Billing & Payments
// ---------------------------------------------------------------------------

// Backs atomic, human-readable sequential numbers per estate (e.g.
// INV-000123). The upsert-with-increment in service code is safe under
// concurrent creation because Postgres serializes on this row's unique
// index lock within a transaction.
model EstateSequence {
  id       String @id @default(cuid())
  estateId String
  key      String
  value    Int    @default(0)

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)

  @@unique([estateId, key])
}

// A billing rule (e.g. "2026 Estate Service Charge") targeting some scope
// of the estate. Its effect is materialized immediately as Invoice rows at
// creation time — targetCriteria is kept only for display/audit, not
// re-resolved later, so changing estate structure afterward can't silently
// change who was billed.
model Charge {
  id             String           @id @default(cuid())
  estateId       String
  title          String
  description    String?
  chargeType     ChargeType
  amountKobo     Int
  dueDate        DateTime
  targetType     ChargeTargetType
  targetCriteria Json
  createdAt      DateTime         @default(now())

  estate   Estate    @relation(fields: [estateId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([estateId])
}

// One invoice = one charge (no multi-charge bundling) — matches how the
// product spec presents billing and avoids an abstraction this phase
// doesn't need. residentId is a snapshot of who was billed at generation
// time, not a live link to current occupancy.
model Invoice {
  id            String        @id @default(cuid())
  estateId      String
  chargeId      String
  unitId        String
  residentId    String?
  invoiceNumber String
  amountKobo    Int
  dueDate       DateTime
  status        InvoiceStatus @default(PENDING)
  createdAt     DateTime      @default(now())

  estate   Estate    @relation(fields: [estateId], references: [id], onDelete: Cascade)
  charge   Charge    @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  unit     Unit      @relation(fields: [unitId], references: [id])
  resident Resident? @relation(fields: [residentId], references: [id])
  payments Payment[]

  @@unique([estateId, invoiceNumber])
  @@index([estateId])
  @@index([unitId])
  @@index([residentId])
}

model Payment {
  id                String        @id @default(cuid())
  estateId          String
  invoiceId         String
  amountKobo        Int
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  paystackReference String?       @unique
  note              String?
  recordedByUserId  String?
  approvedByUserId  String?
  approvedAt        DateTime?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())

  estate  Estate   @relation(fields: [estateId], references: [id], onDelete: Cascade)
  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  receipt Receipt?

  @@index([estateId])
  @@index([invoiceId])
}

model Receipt {
  id            String   @id @default(cuid())
  estateId      String
  paymentId     String   @unique
  receiptNumber String
  issuedAt      DateTime @default(now())

  estate  Estate  @relation(fields: [estateId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([estateId, receiptNumber])
  @@index([estateId])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(cuid())
  estateId    String? // null for platform-level actions
  actorUserId String?
  action      String // e.g. "property.created", "invoice.amount_changed"
  entityType  String
  entityId    String
  beforeJson  Json?
  afterJson   Json?
  createdAt   DateTime @default(now())

  estate Estate? @relation(fields: [estateId], references: [id])
  actor  User?   @relation("ActorUser", fields: [actorUserId], references: [id])

  @@index([estateId])
  @@index([entityType, entityId])
}
