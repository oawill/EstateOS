// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

// A User is an authenticatable identity. It may or may not be linked to a
// Resident profile, and may hold EstateMember roles in one or more estates.
model User {
  id                String    @id @default(cuid())
  email             String?   @unique
  phone             String?   @unique
  passwordHash      String?
  name              String
  isPlatformAdmin   Boolean   @default(false)
  // Stamped on every successful password change (reset or authenticated
  // change) — the JWT session callback compares this against the token's
  // issued-at time to invalidate any session issued before the password
  // changed, since Credentials+JWT auth has no server-side session store
  // to revoke directly. See src/server/auth/config.ts.
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  memberships                EstateMember[]
  residentLinks              Resident[]
  auditLogs                  AuditLog[]           @relation("ActorUser")
  assignedMaintenanceTickets MaintenanceTicket[]  @relation("MaintenanceAssignee")
  assignedHousekeepingTasks  HousekeepingTask[]   @relation("HousekeepingAssignee")
  assignedDemoRequests       DemoRequest[]        @relation("DemoRequestAssignee")
  resolvedCommunityReports   CommunityReport[]    @relation("CommunityReportResolver")
  passwordResetTokens        PasswordResetToken[]
}

// Only the SHA-256 hash of the raw token is ever stored — the raw,
// high-entropy token exists only in memory and in the emailed link, never
// at rest. Single-use (usedAt) and short-lived (expiresAt); a new request
// invalidates any previous unused token for the same user (see
// src/server/auth/passwordReset/service.ts).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Not tied to User — a request for an email that doesn't exist must still
// be counted, or the *absence* of throttling would itself reveal that an
// email is unregistered. Deliberately just enough to rate-limit; not a
// general-purpose security-event log (see AuditLog for that).
model PasswordResetRequestLog {
  id         String   @id @default(cuid())
  emailLower String
  ipHash     String?
  createdAt  DateTime @default(now())

  @@index([emailLower, createdAt])
  @@index([ipHash, createdAt])
}

// ---------------------------------------------------------------------------
// Platform & Plans
// ---------------------------------------------------------------------------

// Deliberately simple: no machine-enforced per-feature entitlement engine,
// since nothing in the app gates functionality by plan today except
// unitLimit (see createProperty in properties/service.ts). featureSummary
// is descriptive only. Pricing is per the spec's "finalize pricing later" —
// this just makes it configurable rather than hard-coded.
model Plan {
  id               String   @id @default(cuid())
  name             String
  monthlyPriceKobo Int
  annualPriceKobo  Int?
  unitLimit        Int? // null = unlimited
  featureSummary   String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  estates Estate[]
}

// ---------------------------------------------------------------------------
// Demo Requests
// ---------------------------------------------------------------------------

// A minimal atomic counter for reference numbers that aren't scoped to an
// estate (unlike EstateSequence, whose estateId FK is required) — same
// upsert-with-increment pattern, see src/server/modules/demoRequests/sequence.ts.
model PlatformSequence {
  key   String @id
  value Int    @default(0)
}

// A public-site "Request a Demo" submission. Deliberately not estate-scoped
// (the prospect doesn't have an estate yet) and not routed through the
// existing scoped()/Notification machinery, which assumes a tenant and a
// resident — see src/server/modules/demoRequests/. Multi-select fields use
// real Postgres enum arrays rather than Json, since these are fixed
// vocabularies the admin UI needs to filter/report on, not free-form data.
model DemoRequest {
  id              String @id @default(cuid())
  referenceNumber String @unique

  fullName               String
  email                  String
  phone                  String
  preferredContactMethod PreferredContactMethod?
  organizationName       String
  organizationType       OrganizationType

  country  String
  region   String?
  city     String
  timezone String?

  numberOfEstates        Int?
  // Nullable — the simplified form captures unitRange (a bucket) instead of
  // a raw count. Kept for older rows / anyone who still supplies an exact
  // number; the admin UI prefers unitRange's label when both are present.
  numberOfUnits          Int?
  unitRange              UnitRangeBucket?
  numberOfResidents      Int?
  shortletUnits          Int?
  // Only asked when interestedFeatures includes SHORTLET_MANAGEMENT.
  shortletBookingProcess String?
  shortletChallenge      String?

  currentManagementMethods ManagementMethod[]
  challenges               ChallengeArea[]
  // The simplified form's single "biggest operational challenge" question —
  // distinct from the (now-unused-in-the-UI, still-stored) multi-select
  // `challenges` above, which older rows may still have.
  primaryChallenge         ChallengeArea?
  interestedFeatures       FeatureInterest[]

  preferredDemoDate     DateTime?
  preferredDemoTime     String?
  alternateDemoDatetime String?
  // Admin-set once a demo is actually arranged — distinct from the
  // prospect's non-binding preference above (see spec: "Do not treat the
  // requested time as a confirmed appointment").
  scheduledDemoAt       DateTime?

  currentSoftware  String?
  primaryObjective String?
  comments         String?
  referralSource   String?
  consent          Boolean

  status           DemoRequestStatus @default(NEW)
  assignedToUserId String?
  // Admin-only working notes — never rendered on any prospect-facing page.
  internalNotes    String?
  // HMAC-SHA256 hash of the submitter's IP (see rateLimit.ts), used only to
  // rate-limit repeat submissions — never stores the raw IP.
  ipHash           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedTo User? @relation("DemoRequestAssignee", fields: [assignedToUserId], references: [id])

  @@index([status])
  @@index([ipHash, createdAt])
}

// ---------------------------------------------------------------------------
// Tenant root
// ---------------------------------------------------------------------------

model Estate {
  id                 String             @id @default(cuid())
  name               String
  slug               String             @unique
  logoUrl            String?
  address            String?
  city               String?
  state              String?
  postalCode         String?
  // Global-ready locale configuration. Nigeria remains the sensible
  // default for every existing and newly-created estate today (the only
  // market EstateOS actually operates in), but these are real per-estate
  // fields, not hardcoded assumptions — an estate admin can change them in
  // Settings, and every new organization is free to pick a different
  // country from creation. See src/lib/locale.ts for how these drive
  // currency/timezone formatting.
  country            String             @default("NG")
  currency           String             @default("NGN")
  timezone           String             @default("Africa/Lagos")
  locale             String             @default("en-NG")
  phoneCountryCode   String             @default("+234")
  contactEmail       String?
  contactPhone       String?
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  planId             String?
  trialEndsAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  plan                   Plan?                   @relation(fields: [planId], references: [id])
  members                EstateMember[]
  blocks                 Block[]
  streets                Street[]
  zones                  Zone[]
  properties             Property[]
  residents              Resident[]
  vehicles               Vehicle[]
  auditLogs              AuditLog[]
  charges                Charge[]
  invoices               Invoice[]
  payments               Payment[]
  receipts               Receipt[]
  sequences              EstateSequence[]
  visitorPasses          VisitorPass[]
  gateEntries            GateEntry[]
  vendors                Vendor[]
  maintenanceTickets     MaintenanceTicket[]
  maintenanceComments    MaintenanceComment[]
  utilityMeters          UtilityMeter[]
  meterReadings          MeterReading[]
  utilityBills           UtilityBill[]
  announcements          Announcement[]
  notifications          Notification[]
  communitySettings      CommunitySettings?
  classifiedCategories   ClassifiedCategory[]
  classifiedListings     ClassifiedListing[]
  classifiedImages       ClassifiedImage[]
  communityPosts         CommunityPost[]
  communityPostImages    CommunityPostImage[]
  communityComments      CommunityComment[]
  communityReactions     CommunityReaction[]
  communitySavedPosts    CommunitySavedPost[]
  communitySavedListings CommunitySavedListing[]
  communityEvents        CommunityEvent[]
  eventRsvps             EventRsvp[]
  communityReports       CommunityReport[]
  listingInquiries       ListingInquiry[]
  shortletSettings       ShortletSettings?
  shortletProperties     ShortletProperty[]
  shortletPropertyImages ShortletPropertyImage[]
  shortletUnits          ShortletUnit[]
  guests                 Guest[]
  reservations           Reservation[]
  availabilityBlocks     AvailabilityBlock[]
  housekeepingTasks      HousekeepingTask[]

  @@index([subscriptionStatus])
}

// Grants a User a Role within a specific Estate. A user can belong to
// multiple estates (e.g. a facility-management company staff member).
model EstateMember {
  id        String   @id @default(cuid())
  estateId  String
  userId    String
  role      Role
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([estateId, userId, role])
  @@index([estateId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Estate geography
// ---------------------------------------------------------------------------

model Block {
  id        String   @id @default(cuid())
  estateId  String
  name      String
  createdAt DateTime @default(now())

  estate     Estate     @relation(fields: [estateId], references: [id], onDelete: Cascade)
  properties Property[]

  @@index([estateId])
}

model Street {
  id        String   @id @default(cuid())
  estateId  String
  name      String
  createdAt DateTime @default(now())

  estate     Estate     @relation(fields: [estateId], references: [id], onDelete: Cascade)
  properties Property[]

  @@index([estateId])
}

model Zone {
  id        String   @id @default(cuid())
  estateId  String
  name      String
  createdAt DateTime @default(now())

  estate     Estate     @relation(fields: [estateId], references: [id], onDelete: Cascade)
  properties Property[]

  @@index([estateId])
}

// ---------------------------------------------------------------------------
// Properties & Units
// ---------------------------------------------------------------------------

// An addressable structure (a duplex, a block of flats, a standalone house).
model Property {
  id           String       @id @default(cuid())
  estateId     String
  blockId      String?
  streetId     String?
  zoneId       String?
  addressLabel String
  propertyType PropertyType
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  estate Estate  @relation(fields: [estateId], references: [id], onDelete: Cascade)
  block  Block?  @relation(fields: [blockId], references: [id])
  street Street? @relation(fields: [streetId], references: [id])
  zone   Zone?   @relation(fields: [zoneId], references: [id])
  units  Unit[]

  @@index([estateId])
}

// The billable / occupiable sub-entity. A standalone house still gets one
// implicit Unit so billing and occupancy always attach to a Unit.
model Unit {
  id              String          @id @default(cuid())
  propertyId      String
  estateId        String
  label           String
  occupancyStatus OccupancyStatus @default(VACANT)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  property      Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  occupancies   Occupancy[]
  invoices      Invoice[]
  utilityMeters UtilityMeter[]

  @@index([estateId])
  @@index([propertyId])
}

// ---------------------------------------------------------------------------
// Residents
// ---------------------------------------------------------------------------

// An estate-scoped profile. May or may not have a linked User (e.g. a
// household member with no login yet).
model Resident {
  id                             String                          @id @default(cuid())
  estateId                       String
  userId                         String?
  firstName                      String
  lastName                       String
  email                          String?
  phone                          String?
  emergencyContactName           String?
  emergencyContactPhone          String?
  // Set when an admin sends (or resends) a portal invite — userId being
  // set is what actually means "activated"; this is just for the admin
  // UI to distinguish "never invited" from "invited, not yet accepted."
  invitedAt                      DateTime?
  // Community preferences/moderation state — nullable, so an unset
  // preference falls back to the estate's CommunitySettings default.
  communityDisplayNamePreference CommunityDisplayNamePreference?
  communityGuidelinesAcceptedAt  DateTime?
  communitySuspendedAt           DateTime?
  communitySuspendedReason       String?
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt

  estate                 Estate                  @relation(fields: [estateId], references: [id], onDelete: Cascade)
  user                   User?                   @relation(fields: [userId], references: [id])
  occupancies            Occupancy[]
  vehicles               Vehicle[]
  invoices               Invoice[]
  visitorPasses          VisitorPass[]
  maintenanceTickets     MaintenanceTicket[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  communityPosts         CommunityPost[]
  communityComments      CommunityComment[]
  communityReactions     CommunityReaction[]
  communitySavedPosts    CommunitySavedPost[]
  classifiedListings     ClassifiedListing[]
  savedListings          CommunitySavedListing[]
  communityEvents        CommunityEvent[]
  eventRsvps             EventRsvp[]
  communityReports       CommunityReport[]
  listingInquiries       ListingInquiry[]
  inviteTokens           ResidentInviteToken[]

  @@index([estateId])
  @@index([userId])
}

// Mirrors PasswordResetToken's shape exactly (hash-only storage,
// single-use, short-lived) — this is "set your password and activate
// your portal account" rather than "reset an existing password," so it's
// keyed by residentId (who may not have a User yet) instead of userId.
model ResidentInviteToken {
  id         String    @id @default(cuid())
  residentId String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  resident Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([residentId])
}

// History of which Resident occupies which Unit, and in what capacity.
model Occupancy {
  id          String        @id @default(cuid())
  unitId      String
  residentId  String
  role        OccupancyRole
  moveInDate  DateTime
  moveOutDate DateTime?
  isCurrent   Boolean       @default(true)
  createdAt   DateTime      @default(now())

  unit     Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  resident Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([unitId])
  @@index([residentId])
}

model Vehicle {
  id          String   @id @default(cuid())
  estateId    String
  residentId  String
  plateNumber String
  make        String?
  model       String?
  color       String?
  createdAt   DateTime @default(now())

  estate   Estate   @relation(fields: [estateId], references: [id], onDelete: Cascade)
  resident Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([estateId])
  @@index([residentId])
}

// ---------------------------------------------------------------------------
// Billing & Payments
// ---------------------------------------------------------------------------

// Backs atomic, human-readable sequential numbers per estate (e.g.
// INV-000123). The upsert-with-increment in service code is safe under
// concurrent creation because Postgres serializes on this row's unique
// index lock within a transaction.
model EstateSequence {
  id       String @id @default(cuid())
  estateId String
  key      String
  value    Int    @default(0)

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)

  @@unique([estateId, key])
}

// A billing rule (e.g. "2026 Estate Service Charge") targeting some scope
// of the estate. Its effect is materialized immediately as Invoice rows at
// creation time — targetCriteria is kept only for display/audit, not
// re-resolved later, so changing estate structure afterward can't silently
// change who was billed.
model Charge {
  id             String           @id @default(cuid())
  estateId       String
  title          String
  description    String?
  chargeType     ChargeType
  amountKobo     Int
  dueDate        DateTime
  targetType     ChargeTargetType
  targetCriteria Json
  createdAt      DateTime         @default(now())

  estate   Estate    @relation(fields: [estateId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([estateId])
}

// One invoice = one charge (no multi-charge bundling) — matches how the
// product spec presents billing and avoids an abstraction this phase
// doesn't need. residentId is a snapshot of who was billed at generation
// time, not a live link to current occupancy.
model Invoice {
  id            String        @id @default(cuid())
  estateId      String
  chargeId      String
  unitId        String
  residentId    String?
  invoiceNumber String
  amountKobo    Int
  dueDate       DateTime
  status        InvoiceStatus @default(PENDING)
  createdAt     DateTime      @default(now())

  estate      Estate       @relation(fields: [estateId], references: [id], onDelete: Cascade)
  charge      Charge       @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  unit        Unit         @relation(fields: [unitId], references: [id])
  resident    Resident?    @relation(fields: [residentId], references: [id])
  payments    Payment[]
  utilityBill UtilityBill?

  @@unique([estateId, invoiceNumber])
  @@index([estateId])
  @@index([unitId])
  @@index([residentId])
}

model Payment {
  id                String        @id @default(cuid())
  estateId          String
  invoiceId         String
  amountKobo        Int
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  paystackReference String?       @unique
  note              String?
  recordedByUserId  String?
  approvedByUserId  String?
  approvedAt        DateTime?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())

  estate  Estate   @relation(fields: [estateId], references: [id], onDelete: Cascade)
  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  receipt Receipt?

  @@index([estateId])
  @@index([invoiceId])
}

model Receipt {
  id            String   @id @default(cuid())
  estateId      String
  paymentId     String   @unique
  receiptNumber String
  issuedAt      DateTime @default(now())

  estate  Estate  @relation(fields: [estateId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([estateId, receiptNumber])
  @@index([estateId])
}

// ---------------------------------------------------------------------------
// Visitors & Gate
// ---------------------------------------------------------------------------

// One invite = one visit occasion — carries the visitor's identity fields
// directly rather than a separate reusable Visitor profile, since nothing
// in this phase needs to reuse a visitor's details across visits.
model VisitorPass {
  id            String          @id @default(cuid())
  estateId      String
  residentId    String // host
  // Purely a labeling/filtering concern for the resident-facing UI — every
  // type shares the exact same underlying credential (PIN/QR/validity
  // window). Adding a genuinely different access type later doesn't
  // require a new model, just a new enum value.
  passType      VisitorPassType @default(VISITOR)
  visitorName   String
  visitorPhone  String?
  vehicleNumber String?
  note          String?
  startTime     DateTime
  expiresAt     DateTime
  // 6 digits, time-scoped uniqueness only (see createVisitorPass) — not a
  // DB unique constraint, since permanently reserving PINs would
  // eventually exhaust the 1,000,000-combination space.
  pin           String
  isRevoked     Boolean         @default(false)
  cancelledAt   DateTime?
  createdAt     DateTime        @default(now())

  estate      Estate      @relation(fields: [estateId], references: [id], onDelete: Cascade)
  resident    Resident    @relation(fields: [residentId], references: [id], onDelete: Cascade)
  gateEntries GateEntry[]

  @@index([estateId])
  @@index([residentId])
}

// A single pass-through-the-gate event. Separate from VisitorPass so one
// pass can be used for multiple entries/exits within its validity window,
// and so "visitors currently checked in" is a direct query
// (checkOutAt IS NULL) rather than derived state on the pass itself.
model GateEntry {
  id             String    @id @default(cuid())
  estateId       String
  passId         String
  gate           String // free text, e.g. "Gate 1" — no Gate model for MVP
  securityUserId String
  checkInAt      DateTime  @default(now())
  checkOutAt     DateTime?
  wasOverride    Boolean   @default(false)
  overrideReason String?

  estate Estate      @relation(fields: [estateId], references: [id], onDelete: Cascade)
  pass   VisitorPass @relation(fields: [passId], references: [id], onDelete: Cascade)

  @@index([estateId])
  @@index([passId])
}

// ---------------------------------------------------------------------------
// Maintenance & Vendors
// ---------------------------------------------------------------------------

// A directory entry a FACILITY_MANAGER can attach to a ticket for
// record-keeping — not a login. A vendor's own staff who need to see
// their assigned tickets are separate Users with Role.VENDOR, linked via
// MaintenanceTicket.assignedToUserId, not via this model.
// Vendor is a first-class EstateOS entity, not information duplicated across
// maintenance requests — see src/server/modules/vendors/. Still a
// directory-only record (no login), same as before; isApproved/contract
// dates/notes are the lightweight expansion requested, deliberately not a
// full procurement/invoicing subsystem.
model Vendor {
  id                String               @id @default(cuid())
  estateId          String
  name              String
  contactName       String?
  phone             String?
  email             String?
  category          MaintenanceCategory?
  isApproved        Boolean              @default(true)
  contractStartDate DateTime?
  contractEndDate   DateTime?
  notes             String?
  createdAt         DateTime             @default(now())

  estate  Estate              @relation(fields: [estateId], references: [id], onDelete: Cascade)
  tickets MaintenanceTicket[]

  @@index([estateId])
}

model MaintenanceTicket {
  id               String              @id @default(cuid())
  estateId         String
  ticketNumber     String
  // Nullable so the same engine can carry an EstateOS Shortlet ticket
  // (shortletUnitId set, no resident) alongside a residential one
  // (residentId set, no shortlet unit) — exactly one is ever set. Every
  // resident-facing code path still always supplies residentId and never
  // touches shortletUnitId, so existing behavior is unchanged.
  residentId       String? // reporter (residential)
  shortletUnitId   String? // EstateOS Shortlet unit (shortlet)
  category         MaintenanceCategory
  description      String
  location         String?
  priority         MaintenancePriority
  status           MaintenanceStatus   @default(REPORTED)
  assignedToUserId String? // internal staff or a VENDOR-role user who can log in
  vendorId         String? // directory-only record, for record-keeping

  residentSatisfied Boolean?
  residentRating    Int?
  residentFeedback  String?

  assignedAt DateTime?
  resolvedAt DateTime?
  closedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  estate         Estate               @relation(fields: [estateId], references: [id], onDelete: Cascade)
  resident       Resident?            @relation(fields: [residentId], references: [id], onDelete: Cascade)
  shortletUnit   ShortletUnit?        @relation(fields: [shortletUnitId], references: [id], onDelete: Cascade)
  vendor         Vendor?              @relation(fields: [vendorId], references: [id])
  assignedToUser User?                @relation("MaintenanceAssignee", fields: [assignedToUserId], references: [id])
  comments       MaintenanceComment[]

  @@unique([estateId, ticketNumber])
  @@index([estateId])
  @@index([residentId])
  @@index([shortletUnitId])
  @@index([assignedToUserId])
}

// Doubles as the resident-visible progress log: a plain note, or a note
// alongside a status transition (newStatus set) — no separate free-form
// discussion feature, since the workflow's status history already is the
// "progress" the spec asks for.
model MaintenanceComment {
  id           String             @id @default(cuid())
  estateId     String
  ticketId     String
  authorUserId String
  body         String
  newStatus    MaintenanceStatus?
  createdAt    DateTime           @default(now())

  estate Estate            @relation(fields: [estateId], references: [id], onDelete: Cascade)
  ticket MaintenanceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([estateId])
  @@index([ticketId])
}

// ---------------------------------------------------------------------------
// Utilities (manual meter billing)
// ---------------------------------------------------------------------------

// Manual-entry only — the schema doesn't assume anything about how a
// reading arrives, so a future automated/smart-meter feed is additive (a
// new reading-creation path), not a rewrite.
model UtilityMeter {
  id          String     @id @default(cuid())
  estateId    String
  unitId      String
  utilityType ChargeType // constrained to ELECTRICITY | WATER in the zod schema
  meterNumber String
  rateKobo    Int // price per consumption unit
  createdAt   DateTime   @default(now())

  estate   Estate         @relation(fields: [estateId], references: [id], onDelete: Cascade)
  unit     Unit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  readings MeterReading[]

  @@index([estateId])
  @@index([unitId])
}

// previousReading auto-copies from this meter's last reading rather than
// being typed in each time — immutable history, no re-entry risk. Null
// only for a meter's very first reading, which just establishes a
// baseline (no bill is generated until a second reading exists).
model MeterReading {
  id               String   @id @default(cuid())
  estateId         String
  meterId          String
  previousReading  Int?
  currentReading   Int
  readingDate      DateTime
  recordedByUserId String
  createdAt        DateTime @default(now())

  estate Estate       @relation(fields: [estateId], references: [id], onDelete: Cascade)
  meter  UtilityMeter @relation(fields: [meterId], references: [id], onDelete: Cascade)
  bill   UtilityBill?

  @@index([estateId])
  @@index([meterId])
}

// Ties a reading to the Invoice it generated. The bill IS an Invoice
// (reusing Paystack/manual payment/receipts/finance-dashboard rather than
// a parallel payment path) — this row just keeps the utility-specific
// consumption/rate detail alongside that Invoice.
model UtilityBill {
  id             String   @id @default(cuid())
  estateId       String
  meterReadingId String   @unique
  invoiceId      String   @unique
  consumption    Int
  rateKobo       Int
  amountKobo     Int
  createdAt      DateTime @default(now())

  estate       Estate       @relation(fields: [estateId], references: [id], onDelete: Cascade)
  meterReading MeterReading @relation(fields: [meterReadingId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([estateId])
}

// ---------------------------------------------------------------------------
// Announcements & Notifications
// ---------------------------------------------------------------------------

// Its effect is materialized immediately as Notification rows at creation
// time, same as Charge/Invoice generation — targetCriteria is kept only
// for display/audit, not re-resolved later.
model Announcement {
  id             String                 @id @default(cuid())
  estateId       String
  authorUserId   String
  title          String
  body           String
  category       AnnouncementCategory
  targetType     AnnouncementTargetType
  targetCriteria Json
  createdAt      DateTime               @default(now())

  estate        Estate         @relation(fields: [estateId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([estateId])
}

// The shared notification event system — announcementId is nullable so a
// future event (payment confirmed, visitor checked in) can use the same
// table/dispatcher without a schema change; this isn't an
// announcements-only inbox.
model Notification {
  id                String                  @id @default(cuid())
  estateId          String
  residentId        String
  announcementId    String?
  // What triggered this notification (e.g. "bill.created",
  // "payment.confirmed", "maintenance.status_changed") — lets a future
  // provider pick the right message template and lets notification
  // history be filtered/reported on by event, not just free-text title.
  eventType         String?
  title             String
  body              String
  channel           NotificationChannelType @default(IN_APP)
  status            NotificationStatus      @default(PENDING)
  // Delivery-provider tracking — unused while only InAppChannel is enabled,
  // populated once a real EMAIL/WHATSAPP/SMS provider is wired in.
  provider          String?
  externalMessageId String?
  failureReason     String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  createdAt         DateTime                @default(now())

  estate       Estate        @relation(fields: [estateId], references: [id], onDelete: Cascade)
  resident     Resident      @relation(fields: [residentId], references: [id], onDelete: Cascade)
  announcement Announcement? @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([estateId])
  @@index([residentId])
  @@index([announcementId])
}

// One row per Resident. Consent is tracked explicitly and separately from
// the "do we have a phone number" question — having a number is never
// treated as permission to message it. Transactional notifications (bills,
// payment confirmations, maintenance updates) are considered a normal part
// of operating the account and aren't gated by marketingOptIn; only
// non-essential/marketing-style messages should ever check that flag.
model NotificationPreference {
  id                    String    @id @default(cuid())
  residentId            String    @unique
  emailOptIn            Boolean   @default(true)
  whatsappOptIn         Boolean   @default(false)
  whatsappNumber        String?
  whatsappCountryCode   String?
  whatsappConsentAt     DateTime?
  whatsappConsentSource String?
  whatsappOptOutAt      DateTime?
  marketingOptIn        Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  resident Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Community (Feed, Classifieds, Events, Moderation)
// ---------------------------------------------------------------------------

// One row per estate. Deliberately created lazily (see
// src/server/modules/community/settings.ts) rather than at Estate creation
// time, same as how ClassifiedCategory rows are seeded on first access.
model CommunitySettings {
  id                           String                         @id @default(cuid())
  estateId                     String                         @unique
  communityEnabled             Boolean                        @default(true)
  classifiedsEnabled           Boolean                        @default(true)
  listingsRequireApproval      Boolean                        @default(false)
  guidelinesText               String?
  defaultDisplayNamePreference CommunityDisplayNamePreference @default(FIRST_NAME_LAST_INITIAL)
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)
}

// Per-estate, not a global enum, so an admin can enable/disable which
// categories their estate uses (spec: "configure available categories per
// estate") — seeded from a fixed default list on first access, not
// arbitrary free-text categories, to keep Classifieds search/filter
// meaningful.
model ClassifiedCategory {
  id        String   @id @default(cuid())
  estateId  String
  key       String
  label     String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  estate   Estate              @relation(fields: [estateId], references: [id], onDelete: Cascade)
  listings ClassifiedListing[]

  @@unique([estateId, key])
  @@index([estateId])
}

// The shortlet-specific fields below are nullable and only populated when
// categoryId points at the Shortlets category — deliberately not a
// separate booking model (see spec: "do not build a full Airbnb-style
// marketplace"), just a few extra optional columns on the same listing.
model ClassifiedListing {
  id               String                  @id @default(cuid())
  estateId         String
  sellerResidentId String
  categoryId       String
  title            String
  description      String
  priceKobo        Int?
  currency         String                  @default("NGN")
  negotiable       Boolean                 @default(false)
  condition        ClassifiedCondition?
  // Optional, deliberately coarse (e.g. "Near Block C") — never the
  // resident's exact unit number, which stays server-side only (see
  // getDisplayIdentity() — public listing/post views never expose it).
  locationNote     String?
  contactMethods   ListingContactMethod[]
  whatsappNumber   String?
  phoneNumber      String?
  status           ClassifiedListingStatus @default(ACTIVE)
  moderationStatus CommunityVisibility     @default(VISIBLE)
  expiresAt        DateTime?
  // Null while pending when CommunitySettings.listingsRequireApproval is
  // on; set the moment it's created otherwise.
  approvedAt       DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  nightlyRateKobo Int?
  bedrooms        Int?
  maxGuests       Int?
  amenities       String[]
  availableFrom   DateTime?
  availableTo     DateTime?

  estate    Estate                  @relation(fields: [estateId], references: [id], onDelete: Cascade)
  seller    Resident                @relation(fields: [sellerResidentId], references: [id], onDelete: Cascade)
  category  ClassifiedCategory      @relation(fields: [categoryId], references: [id])
  images    ClassifiedImage[]
  savedBy   CommunitySavedListing[]
  inquiries ListingInquiry[]

  @@index([estateId, status])
  @@index([categoryId])
}

model ClassifiedImage {
  id        String   @id @default(cuid())
  estateId  String
  listingId String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  estate  Estate            @relation(fields: [estateId], references: [id], onDelete: Cascade)
  listing ClassifiedListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model CommunitySavedListing {
  id         String   @id @default(cuid())
  estateId   String
  residentId String
  listingId  String
  createdAt  DateTime @default(now())

  estate   Estate            @relation(fields: [estateId], references: [id], onDelete: Cascade)
  resident Resident          @relation(fields: [residentId], references: [id], onDelete: Cascade)
  listing  ClassifiedListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([residentId, listingId])
  @@index([estateId])
}

// A one-shot message to a seller, delivered as a row the seller reads on
// their own listing — the MVP's "in-app contact option", deliberately not
// a threaded conversation (see spec §12: reuse existing infra, don't build
// a separate messaging system; EstateOS has none today).
model ListingInquiry {
  id              String   @id @default(cuid())
  estateId        String
  listingId       String
  buyerResidentId String
  message         String
  createdAt       DateTime @default(now())

  estate  Estate            @relation(fields: [estateId], references: [id], onDelete: Cascade)
  listing ClassifiedListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer   Resident          @relation(fields: [buyerResidentId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

// Lost & Found is a postType, not a separate system (spec §14: "should
// also appear within Community Classifieds/Feed") — lostFoundKind/
// lostFoundResolvedAt are only populated when postType = LOST_FOUND.
// Official estate posts are NOT rows here — the Feed reads Announcement
// directly and interleaves it at query time (see
// src/server/modules/community/posts.ts) to avoid duplicating that data.
model CommunityPost {
  id                  String              @id @default(cuid())
  estateId            String
  authorResidentId    String
  postType            CommunityPostType   @default(TEXT)
  body                String
  lostFoundKind       LostFoundKind?
  lostFoundResolvedAt DateTime?
  moderationStatus    CommunityVisibility @default(VISIBLE)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  estate    Estate               @relation(fields: [estateId], references: [id], onDelete: Cascade)
  author    Resident             @relation(fields: [authorResidentId], references: [id], onDelete: Cascade)
  images    CommunityPostImage[]
  comments  CommunityComment[]
  reactions CommunityReaction[]
  savedBy   CommunitySavedPost[]

  @@index([estateId, createdAt])
}

model CommunityPostImage {
  id        String   @id @default(cuid())
  estateId  String
  postId    String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  estate Estate        @relation(fields: [estateId], references: [id], onDelete: Cascade)
  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

// parentCommentId supports one level of "Reply" (spec §6) — not a full
// arbitrarily-nested thread.
model CommunityComment {
  id               String              @id @default(cuid())
  estateId         String
  postId           String
  authorResidentId String
  parentCommentId  String?
  body             String
  moderationStatus CommunityVisibility @default(VISIBLE)
  createdAt        DateTime            @default(now())

  estate    Estate              @relation(fields: [estateId], references: [id], onDelete: Cascade)
  post      CommunityPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    Resident            @relation(fields: [authorResidentId], references: [id], onDelete: Cascade)
  parent    CommunityComment?   @relation("CommentReplies", fields: [parentCommentId], references: [id])
  replies   CommunityComment[]  @relation("CommentReplies")
  reactions CommunityReaction[]

  @@index([postId])
}

// Single LIKE type for now (spec: "keep reactions simple initially") —
// exactly one of postId/commentId is set. Postgres treats each NULL as
// distinct in a unique index, so the two partial-key uniques below don't
// conflict with each other.
model CommunityReaction {
  id         String   @id @default(cuid())
  estateId   String
  residentId String
  postId     String?
  commentId  String?
  createdAt  DateTime @default(now())

  estate   Estate            @relation(fields: [estateId], references: [id], onDelete: Cascade)
  resident Resident          @relation(fields: [residentId], references: [id], onDelete: Cascade)
  post     CommunityPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment  CommunityComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([residentId, postId])
  @@unique([residentId, commentId])
  @@index([estateId])
}

model CommunitySavedPost {
  id         String   @id @default(cuid())
  estateId   String
  residentId String
  postId     String
  createdAt  DateTime @default(now())

  estate   Estate        @relation(fields: [estateId], references: [id], onDelete: Cascade)
  resident Resident      @relation(fields: [residentId], references: [id], onDelete: Cascade)
  post     CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([residentId, postId])
  @@index([estateId])
}

model CommunityEvent {
  id                  String              @id @default(cuid())
  estateId            String
  organizerResidentId String?
  title               String
  description         String?
  eventDate           DateTime
  eventTime           String?
  location            String?
  moderationStatus    CommunityVisibility @default(VISIBLE)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  estate    Estate      @relation(fields: [estateId], references: [id], onDelete: Cascade)
  organizer Resident?   @relation(fields: [organizerResidentId], references: [id])
  rsvps     EventRsvp[]

  @@index([estateId, eventDate])
}

model EventRsvp {
  id         String          @id @default(cuid())
  estateId   String
  eventId    String
  residentId String
  status     EventRsvpStatus
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  estate   Estate         @relation(fields: [estateId], references: [id], onDelete: Cascade)
  event    CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  resident Resident       @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@unique([eventId, residentId])
  @@index([estateId])
}

// A resident filing a report — user-generated content, distinct from the
// moderation *action* taken on it (which reuses the existing AuditLog,
// see recordAudit() in src/server/modules/community/moderation.ts).
model CommunityReport {
  id                 String                    @id @default(cuid())
  estateId           String
  reporterResidentId String
  targetType         CommunityReportTargetType
  targetId           String
  reason             CommunityReportReason
  details            String?
  status             CommunityReportStatus     @default(OPEN)
  createdAt          DateTime                  @default(now())
  resolvedAt         DateTime?
  resolvedByUserId   String?

  estate     Estate   @relation(fields: [estateId], references: [id], onDelete: Cascade)
  reporter   Resident @relation(fields: [reporterResidentId], references: [id], onDelete: Cascade)
  resolvedBy User?    @relation("CommunityReportResolver", fields: [resolvedByUserId], references: [id])

  @@index([estateId, status])
}

// ---------------------------------------------------------------------------
// EstateOS Shortlet — a separate operations module for shortlet/serviced-
// apartment operators, deliberately kept apart from the residential
// Community/Classifieds experience above. Reuses Estate/EstateMember/RBAC/
// scoped()/AuditLog/S3 rather than a parallel tenant concept — an operator
// estate simply never populates the residential geography/resident tables.
// ---------------------------------------------------------------------------

// One row per estate, created lazily on first platform-admin toggle (same
// pattern as CommunitySettings) — enabling Shortlet is a platform-admin
// controlled subscription entitlement, not an estate-admin self-serve
// toggle like Community.
model ShortletSettings {
  id              String   @id @default(cuid())
  estateId        String   @unique
  enabled         Boolean  @default(false)
  defaultCurrency String   @default("NGN")
  defaultTimezone String   @default("Africa/Lagos")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)
}

model ShortletProperty {
  id                   String                 @id @default(cuid())
  estateId             String
  name                 String
  propertyType         ShortletPropertyType
  address              String
  country              String
  city                 String
  // Nullable overrides of ShortletSettings.defaultCurrency/defaultTimezone
  // — a property manager's portfolio can span multiple markets (a Lagos
  // property and a future Accra or Nairobi property), so each property may
  // opt out of the estate-wide default rather than being forced onto it.
  // Null means "use the estate default."
  currency             String?
  timezone             String?
  bedrooms             Int
  bathrooms            Int
  maxGuests            Int
  amenities            String[]
  description          String?
  houseRules           String?
  checkInTime          String // e.g. "15:00" — interpreted in ShortletSettings.defaultTimezone
  checkOutTime         String
  baseNightlyRateMinor Int
  cleaningFeeMinor     Int                    @default(0)
  securityDepositMinor Int                    @default(0)
  minStayNights        Int                    @default(1)
  maxStayNights        Int?
  status               ShortletPropertyStatus @default(ACTIVE)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  estate Estate                  @relation(fields: [estateId], references: [id], onDelete: Cascade)
  units  ShortletUnit[]
  images ShortletPropertyImage[]

  @@index([estateId, status])
}

model ShortletPropertyImage {
  id         String   @id @default(cuid())
  estateId   String
  propertyId String
  url        String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  estate   Estate           @relation(fields: [estateId], references: [id], onDelete: Cascade)
  property ShortletProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

// The actual bookable entity — mirrors the Property -> Unit split in the
// residential schema exactly, so a single-unit property still gets one
// auto-created unit and Reservations always reference a unit, never a
// property directly (supports "multiple units within one building").
model ShortletUnit {
  id         String                 @id @default(cuid())
  estateId   String
  propertyId String
  unitLabel  String
  status     ShortletPropertyStatus @default(ACTIVE)
  createdAt  DateTime               @default(now())

  estate             Estate              @relation(fields: [estateId], references: [id], onDelete: Cascade)
  property           ShortletProperty    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservations       Reservation[]
  availabilityBlocks AvailabilityBlock[]
  maintenanceTickets MaintenanceTicket[]
  housekeepingTasks  HousekeepingTask[]

  @@index([estateId])
  @@index([propertyId])
}

// Deliberately separate from Resident — a shortlet guest is not an estate
// resident. "Previous stays" is derived from the Reservation relation, not
// a stored field.
model Guest {
  id                    String   @id @default(cuid())
  estateId              String
  fullName              String
  phone                 String
  email                 String?
  country               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  vehicleDetails        String?
  idType                String?
  idNumber              String?
  notes                 String?
  preferences           String?
  createdAt             DateTime @default(now())

  estate       Estate        @relation(fields: [estateId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@index([estateId])
}

// Amounts are plain fields this phase (no Payment integration yet — see
// Phase 2 of the Shortlet build). outstandingAmountMinor is intentionally
// not stored: it's always totalAmountMinor - amountPaidMinor, computed by
// callers, same "recompute rather than trust a stale field" instinct as
// Invoice.status elsewhere in this schema.
model Reservation {
  id                    String                @id @default(cuid())
  estateId              String
  reservationNumber     String
  unitId                String
  guestId               String
  checkInDate           DateTime
  checkOutDate          DateTime
  numberOfGuests        Int
  nightlyRateMinor      Int
  nights                Int
  taxesMinor            Int                   @default(0)
  cleaningFeeMinor      Int                   @default(0)
  securityDepositMinor  Int                   @default(0)
  discountMinor         Int                   @default(0)
  additionalFeesMinor   Int                   @default(0)
  totalAmountMinor      Int
  amountPaidMinor       Int                   @default(0)
  bookingSource         ShortletBookingSource
  status                ReservationStatus     @default(PENDING)
  notes                 String?
  createdByUserId       String?
  // Future channel-manager integration readiness (spec: "ensure
  // reservations can contain booking source, external reservation ID,
  // external channel, synchronization status") — no integration or sync
  // logic exists yet, these are just cheap, additive columns so a future
  // integration doesn't need another migration.
  externalReservationId String?
  externalChannel       String?
  syncStatus            String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  estate Estate       @relation(fields: [estateId], references: [id], onDelete: Cascade)
  unit   ShortletUnit @relation(fields: [unitId], references: [id])
  guest  Guest        @relation(fields: [guestId], references: [id])

  @@unique([estateId, reservationNumber])
  @@index([estateId, status])
  @@index([unitId, checkInDate, checkOutDate])
}

// A cleaning task for a Shortlet unit. "Cleaning required" for dashboard/
// calendar purposes is derived (does this unit have an open task?), not a
// stored status on ShortletUnit — avoids two sources of truth needing to
// stay in sync. Auto-created (status PENDING) when a Reservation transitions
// to CHECKED_OUT — see updateReservationStatus in
// src/server/modules/shortlet/reservations.ts.
model HousekeepingTask {
  id               String               @id @default(cuid())
  estateId         String
  unitId           String
  status           HousekeepingStatus   @default(PENDING)
  assignedToUserId String?
  dueAt            DateTime?
  priority         MaintenancePriority?
  notes            String?
  completedAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  estate         Estate       @relation(fields: [estateId], references: [id], onDelete: Cascade)
  unit           ShortletUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  assignedToUser User?        @relation("HousekeepingAssignee", fields: [assignedToUserId], references: [id])

  @@index([estateId, status])
  @@index([unitId])
}

// Owner-blocked / manually-unavailable date ranges, feeding the calendar's
// non-reservation states. Maintenance-driven blocking arrives in Phase 3
// once the maintenance-integration models exist — "OTHER" covers the gap
// until then.
model AvailabilityBlock {
  id              String                  @id @default(cuid())
  estateId        String
  unitId          String
  startDate       DateTime
  endDate         DateTime
  reason          AvailabilityBlockReason
  notes           String?
  createdByUserId String?
  createdAt       DateTime                @default(now())

  estate Estate       @relation(fields: [estateId], references: [id], onDelete: Cascade)
  unit   ShortletUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId, startDate, endDate])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(cuid())
  estateId    String? // null for platform-level actions
  actorUserId String?
  action      String // e.g. "property.created", "invoice.amount_changed"
  entityType  String
  entityId    String
  beforeJson  Json?
  afterJson   Json?
  createdAt   DateTime @default(now())

  estate Estate? @relation(fields: [estateId], references: [id])
  actor  User?   @relation("ActorUser", fields: [actorUserId], references: [id])

  @@index([estateId])
  @@index([entityType, entityId])
}
