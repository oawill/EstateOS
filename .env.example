# Postgres (local Docker by default — see docker-compose.yml)
DATABASE_URL="postgresql://estateos:estateos@localhost:5432/estateos?schema=public"

# Only needed if your DB role lacks CREATEDB — point this at a pre-created
# empty database and Prisma will use it instead of creating one itself.
# SHADOW_DATABASE_URL="postgresql://estateos:estateos@localhost:5432/estateos_shadow?schema=public"

# Auth.js
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-32-byte-secret"
AUTH_URL="http://localhost:3000"

# Paystack — optional. Without these, online card/bank payment fails
# gracefully with a message pointing residents to manual bank-transfer
# recording instead. Get test keys from your Paystack dashboard.
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=

# S3-compatible storage — optional. Works with AWS S3, Cloudflare R2,
# DigitalOcean Spaces, Backblaze B2, or any S3-compatible endpoint. Powers
# photo uploads in Community (posts/classifieds). Without these, Community
# still works fully as text-only — the photo picker just doesn't appear.
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION="auto"

# Demo requests — email notifications via Resend. Optional: without
# RESEND_API_KEY, demo requests still save to the database, but the
# customer-service and prospect confirmation emails are skipped (logged
# as a warning) instead of sent.
CUSTOMER_SERVICE_EMAIL="hello@example.com"
# RESEND_API_KEY=
# EMAIL_FROM="EstateOS <demo@yourdomain.com>"
